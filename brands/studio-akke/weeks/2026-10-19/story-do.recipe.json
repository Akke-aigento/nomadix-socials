{"version":1,"width":1080,"height":1920,"html":"<!doctype html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"nx-size\" content=\"1080x1920\">\n<style>/* Studio Akke — huisstijl voor Instagram (posts 1080x1350, stories/reels 1080x1920).\n   Afgeleid van studioakke.com: donker navy → violet verloop, teal → cyaan als accent, koraal max. één element per beeld.\n   Fonts: Inter (titels 800/900, tekst 400–600) en JetBrains Mono (kleine \"code\"-labels). Beide OFL, lokaal in ./fonts. */\n\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/studio-akke/fonts/inter-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/studio-akke/fonts/inter-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/studio-akke/fonts/inter-latin-600-normal.woff2\") format(\"woff2\"); font-weight: 600; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/studio-akke/fonts/inter-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/studio-akke/fonts/inter-latin-800-normal.woff2\") format(\"woff2\"); font-weight: 800; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/studio-akke/fonts/inter-latin-900-normal.woff2\") format(\"woff2\"); font-weight: 900; }\n@font-face { font-family: \"JetBrains Mono\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/studio-akke/fonts/jetbrains-mono-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"JetBrains Mono\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/studio-akke/fonts/jetbrains-mono-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"JetBrains Mono\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/studio-akke/fonts/jetbrains-mono-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n\n:root {\n  --navy: #0F1729;        /* achtergrond */\n  --violet: #211438;      /* tweede kleur van het verloop */\n  --card: #1D283A;        /* vlakken */\n  --line: rgba(255,255,255,.12);\n  --teal: #2BD4BD;        /* primair */\n  --teal-light: #5EEAD4;\n  --cyan: #22D3EE;\n  --sky: #38BDF8;\n  --coral: #F2456D;       /* accent, max. één element per beeld */\n  --white: #FFFFFF;\n  --mute: #94A3B8;\n  --paper: #F4F7FB;       /* lichte variant */\n  --pad: 72px;\n  --grad: linear-gradient(135deg, var(--teal-light) 0%, var(--cyan) 50%, var(--sky) 100%);\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { width: 100%; height: 100%; }\nbody {\n  background: linear-gradient(135deg, var(--navy) 0%, var(--violet) 100%);\n  color: var(--white); font-family: \"Inter\", sans-serif; -webkit-font-smoothing: antialiased;\n  overflow: hidden; position: relative;\n}\nbody.paper { background: var(--paper); color: var(--navy); }\n\n/* Typografie */\n.h { font-weight: 900; letter-spacing: -.035em; line-height: .98; }\n.h-xl { font-size: 132px; }\n.h-l  { font-size: 104px; }\n.h-m  { font-size: 76px; }\n.h-s  { font-size: 54px; letter-spacing: -.025em; }\n.grad { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }\n.lead { font-size: 36px; line-height: 1.38; font-weight: 500; color: rgba(255,255,255,.88); }\n.body { font-size: 29px; line-height: 1.45; color: rgba(255,255,255,.8); }\n.paper .lead, .paper .body { color: #334155; }\n.code { font-family: \"JetBrains Mono\", monospace; font-size: 24px; font-weight: 500; letter-spacing: .02em; color: var(--teal); }\n.code .c { color: var(--mute); }\n.coral { color: var(--coral); }\n.teal { color: var(--teal); }\n.mute { color: var(--mute); }\n\n/* Gloed en raster (sfeer, zoals de hero van de site) */\n.glow { position: absolute; border-radius: 50%; filter: blur(110px); }\n.glow.teal { background: rgba(43,212,189,.28); }\n.glow.violet { background: rgba(124,58,237,.30); }\n.grid { position: absolute; inset: 0; opacity: .5;\n  background-image: linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);\n  background-size: 54px 54px; -webkit-mask-image: radial-gradient(ellipse at 70% 30%, #000 10%, transparent 70%); mask-image: radial-gradient(ellipse at 70% 30%, #000 10%, transparent 70%); }\n\n/* Logo: merkteken (svg) + woordmerk in HTML-tekst */\n.brand { position: absolute; display: flex; align-items: center; gap: 14px; font-size: 34px; font-weight: 800; letter-spacing: -.02em; }\n.brand img { width: 62px; height: 62px; }\n.brand b { font-weight: 900; color: var(--teal-light); }\n.brand.tl { top: 64px; left: var(--pad); }\n.brand.bl { bottom: 64px; left: var(--pad); }\n.paper .brand { color: var(--navy); }\n.paper .brand b { color: #0D9488; }\n\n/* Browservenster rond een schermafbeelding van een site */\n.browser { position: absolute; border-radius: 22px; overflow: hidden; background: #0B1222; border: 1px solid rgba(255,255,255,.14);\n  box-shadow: 0 50px 90px -30px rgba(0,0,0,.75), 0 0 0 1px rgba(0,0,0,.2); }\n.browser .bar { height: 54px; display: flex; align-items: center; gap: 10px; padding: 0 22px; background: #111A2E; border-bottom: 1px solid rgba(255,255,255,.08); }\n.browser .bar i { width: 13px; height: 13px; border-radius: 50%; background: #334155; display: block; }\n.browser .bar i:nth-child(1) { background: #F2456D; } .browser .bar i:nth-child(2) { background: #F5B83D; } .browser .bar i:nth-child(3) { background: #2BD4BD; }\n.browser .bar span { margin-left: 18px; flex: 1; height: 32px; border-radius: 9px; background: rgba(255,255,255,.06); font-family: \"JetBrains Mono\", monospace; font-size: 18px; color: var(--mute); display: flex; align-items: center; padding: 0 16px; }\n.browser img.shot { display: block; width: 100%; height: calc(100% - 54px); object-fit: cover; object-position: top center; }\n\n/* Labels, pillen, prijs */\n.tag { display: inline-flex; align-items: center; gap: 10px; padding: 10px 20px; border-radius: 999px; border: 1px solid var(--line); background: rgba(255,255,255,.05); font-size: 22px; font-weight: 600; color: rgba(255,255,255,.85); }\n.tag .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--teal); }\n.pill { display: inline-flex; align-items: center; gap: 14px; padding: 20px 32px; border-radius: 999px; font-size: 28px; font-weight: 700; }\n.pill.teal { background: var(--teal); color: var(--navy); }\n.pill.ghost { border: 2px solid rgba(255,255,255,.3); color: var(--white); }\n.price { font-size: 92px; font-weight: 900; letter-spacing: -.04em; line-height: 1; }\n.vat { font-size: 22px; color: var(--mute); font-weight: 500; }\n\n/* Kaarten en lijsten */\n.card { background: rgba(29,40,58,.72); border: 1px solid var(--line); border-radius: 28px; padding: 40px 44px; }\n.card.hot { border: 2px solid var(--teal); box-shadow: 0 0 0 8px rgba(43,212,189,.08); }\n.checks { display: grid; gap: 18px; list-style: none; }\n.checks li { display: flex; gap: 18px; align-items: flex-start; font-size: 29px; line-height: 1.35; color: rgba(255,255,255,.88); }\n.checks li::before { content: \"\"; flex: 0 0 34px; height: 34px; border-radius: 50%; margin-top: 1px;\n  background: rgba(43,212,189,.18) url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%232BD4BD' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><path d='M6 12.5l4 4 8-9'/></svg>\") center/20px no-repeat; }\n.steps { display: grid; gap: 22px; }\n.step { display: grid; grid-template-columns: 88px 1fr auto; gap: 26px; align-items: center; padding: 26px 0; border-top: 1px solid var(--line); }\n.step .n { font-family: \"JetBrains Mono\", monospace; font-size: 40px; font-weight: 700; color: var(--teal); }\n.step .t { font-size: 36px; font-weight: 800; letter-spacing: -.02em; }\n.step .d { font-size: 25px; color: var(--mute); margin-top: 6px; line-height: 1.35; }\n.step .time { font-family: \"JetBrains Mono\", monospace; font-size: 22px; color: var(--mute); white-space: nowrap; }\n\n/* Groot genummerd cijfer (tips) */\n.num { font-size: 320px; font-weight: 900; line-height: .8; letter-spacing: -.06em; color: transparent; -webkit-text-stroke: 2px rgba(43,212,189,.55); }\n\n/* Leeg vak voor een sticker (poll, vraag, link) in stories */\n.sticker-slot { border-radius: 30px; font-size: 0; color: transparent; } /* leeg vak: hier plakt Akke de sticker */\n\n/* Carrousel-paginering */\n.dots { position: absolute; bottom: 70px; right: var(--pad); display: flex; gap: 10px; }\n.dots i { width: 12px; height: 12px; border-radius: 50%; background: rgba(255,255,255,.22); display: block; }\n.dots i.on { background: var(--teal); width: 34px; border-radius: 99px; }\n.swipe { position: absolute; bottom: 64px; right: var(--pad); font-family: \"JetBrains Mono\", monospace; font-size: 22px; color: var(--mute); }\n\n/* Veilige zones voor stories/reels: boven 250 px en onder 340 px vrij van tekst */\n.story-safe { position: absolute; top: 250px; bottom: 340px; left: var(--pad); right: var(--pad); }\n</style>\n</head>\n<body>\n  <div class=\"grid\"></div>\n  <div class=\"glow teal\" style=\"width:820px; height:820px; right:-320px; top:260px\"></div>\n  <div class=\"glow violet\" style=\"width:820px; height:820px; left:-320px; bottom:120px\"></div>\n  <div class=\"story-safe\" style=\"display:flex; flex-direction:column; gap:40px\">\n    <div class=\"brand\" style=\"position:relative\"><img src=\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/studio-akke/mark.svg\" alt=\"\">Studio <b>Akke</b></div>\n    <div class=\"code\"><span class=\"c\">//</span> gratis scan</div>\n    <h1 class=\"h h-l\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"50\">Hoe goed vindt<br>Google <span class=\"grad\">jouw site?</span></h1>\n    <p class=\"lead\" data-slot=\"tekst\" data-label=\"Tekst\" data-max=\"140\">Vul je webadres in. Binnen een halve minuut zie je je score en de drie dingen die je vindbaarheid het meest tegenhouden.</p>\n    <div class=\"code\" style=\"font-size:30px; color:var(--white)\">studioakke.com/insights</div>\n    <div class=\"sticker-slot\" style=\"height:200px; margin-top:auto\">link-sticker hier</div>\n  </div>\n</body>\n</html>\n"}