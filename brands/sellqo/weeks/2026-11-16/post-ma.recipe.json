{"version":1,"width":1080,"height":1350,"html":"<!doctype html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"nx-size\" content=\"1080x1350\">\n<title>Feature: openingsuren aan de deur</title>\n<style>/* SellQo — huisstijl voor Instagram (posts/carrousels 1080x1350, stories/reels 1080x1920, LinkedIn 1200x1200).\n   Kleuren uit het logo: navy #00145B (primair) en koraal #FD7B5B (accent). Vriendelijk en rond, zoals het tasje.\n   Fonts: Poppins (titels) en Inter (tekst), beide OFL, lokaal in ./fonts.\n   Hoofdmotief: getrouwe UI-scènes (bestelling, factuur, kassa, keuken, ticket) met copy uit de echte app. */\n\n@font-face { font-family: \"Poppins\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/poppins-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"Poppins\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/poppins-latin-600-normal.woff2\") format(\"woff2\"); font-weight: 600; }\n@font-face { font-family: \"Poppins\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/poppins-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n@font-face { font-family: \"Poppins\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/poppins-latin-800-normal.woff2\") format(\"woff2\"); font-weight: 800; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/inter-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/inter-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/inter-latin-600-normal.woff2\") format(\"woff2\"); font-weight: 600; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/inter-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n\n:root {\n  --navy: #00145B;       /* primair */\n  --deep: #0A1033;       /* donkere achtergrond */\n  --deep-2: #141B47;     /* vlak op donker */\n  --coral: #FD7B5B;      /* accent */\n  --coral-soft: #FFE3DA;\n  --orange: #FF6933;     /* site-knop, spaarzaam */\n  --cream: #FFF7F2;      /* lichte achtergrond */\n  --white: #FFFFFF;\n  --mute: #8A93B8;       /* grijsblauw */\n  --line: rgba(0,20,91,.10);\n  --line-d: rgba(255,255,255,.12);\n  --green: #1FA971;      /* status \"klaar/betaald\" in UI-scènes */\n  --pad: 80px;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { width: 100%; height: 100%; }\nbody { background: var(--cream); color: var(--navy); font-family: \"Inter\", sans-serif; -webkit-font-smoothing: antialiased; overflow: hidden; position: relative; }\nbody.dark { background: var(--deep); color: var(--white); }\n\n/* Typografie */\n.h { font-family: \"Poppins\", sans-serif; font-weight: 700; line-height: 1.04; letter-spacing: -.02em; }\n.h-xl { font-size: 112px; }\n.h-l { font-size: 88px; }\n.h-m { font-size: 64px; }\n.h-s { font-size: 44px; }\n.lead { font-size: 34px; line-height: 1.4; font-weight: 500; }\n.body { font-size: 28px; line-height: 1.45; }\n.mute { color: var(--mute); }\n.coral { color: var(--coral); }\n.kicker { font-family: \"Poppins\", sans-serif; font-size: 24px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--coral); }\n.hl { background: linear-gradient(transparent 62%, var(--coral-soft) 62%); padding: 0 6px; margin: 0 -6px; }\nbody.dark .hl { background: none; color: var(--coral); }\n\n/* Logo */\n.logo { position: absolute; height: 64px; width: auto; }\n.logo.tl { top: 72px; left: var(--pad); }\n.logo.tr { top: 72px; right: var(--pad); }\n.logo.bl { bottom: 72px; left: var(--pad); }\n.logo.br { bottom: 72px; right: var(--pad); }\n\n/* Zachte vormen op de achtergrond (rond, zoals het tasje) */\n.blob { position: absolute; border-radius: 50%; }\n.blob.coral { background: var(--coral); }\n.blob.soft { background: var(--coral-soft); }\n.blob.navy { background: var(--navy); }\n.dots { position: absolute; background-image: radial-gradient(var(--line) 3px, transparent 3px); background-size: 34px 34px; }\nbody.dark .dots { background-image: radial-gradient(rgba(255,255,255,.09) 3px, transparent 3px); }\n\n/* UI-scène: kaartjes zoals in de app */\n.card { position: absolute; background: var(--white); border-radius: 28px; box-shadow: 0 30px 60px -20px rgba(0,20,91,.28), 0 0 0 1px var(--line); padding: 32px 36px; color: var(--navy); }\n.card.tilt-l { transform: rotate(-2.5deg); }\n.card.tilt-r { transform: rotate(2deg); }\n.card .ttl { font-family: \"Poppins\", sans-serif; font-weight: 600; font-size: 26px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }\n.card .row { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 16px 0; border-top: 1px solid var(--line); font-size: 24px; }\n.card .row:first-of-type { border-top: 0; }\n.card .row b { font-weight: 600; }\n.card .sub { font-size: 20px; color: var(--mute); margin-top: 4px; }\n.card .big { font-family: \"Poppins\", sans-serif; font-weight: 700; font-size: 56px; line-height: 1; }\n.chip { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: 999px; font-size: 19px; font-weight: 600; white-space: nowrap; }\n.chip.new { background: var(--coral-soft); color: #C9452A; }\n.chip.ok { background: #DDF5EA; color: #13804F; }\n.chip.blue { background: #E4E8F7; color: var(--navy); }\n.chip.dark { background: var(--navy); color: var(--white); }\n.btn { display: inline-flex; align-items: center; justify-content: center; padding: 18px 30px; border-radius: 16px; background: var(--orange); color: var(--white); font-weight: 600; font-size: 24px; }\n.toast { position: absolute; display: flex; align-items: center; gap: 16px; padding: 22px 30px; border-radius: 20px; background: var(--navy); color: var(--white); font-size: 24px; font-weight: 500; box-shadow: 0 24px 48px -16px rgba(0,20,91,.5); }\n.toast .tick { width: 36px; height: 36px; border-radius: 50%; background: var(--green); display: grid; place-items: center; font-weight: 700; font-size: 20px; }\n\n/* Pillen / CTA onderaan */\n.pill { display: inline-flex; align-items: center; gap: 14px; padding: 20px 32px; border-radius: 999px; font-size: 26px; font-weight: 600; font-family: \"Poppins\", sans-serif; }\n.pill.coral { background: var(--coral); color: var(--white); }\n.pill.navy { background: var(--navy); color: var(--white); }\n.pill.ghost { border: 2px solid var(--line); }\nbody.dark .pill.ghost { border-color: var(--line-d); }\n\n/* Genummerde stap (carrousels) */\n.step { width: 96px; height: 96px; border-radius: 50%; background: var(--coral); color: var(--white); display: grid; place-items: center; font-family: \"Poppins\", sans-serif; font-weight: 700; font-size: 44px; }\n.swipe { position: absolute; right: var(--pad); bottom: 80px; font-family: \"Poppins\", sans-serif; font-weight: 600; font-size: 24px; display: flex; align-items: center; gap: 12px; }\n.counter { position: absolute; right: var(--pad); top: 84px; font-family: \"Poppins\", sans-serif; font-weight: 600; font-size: 24px; color: var(--mute); }\n\n/* Mythe / feit */\n.myth { padding: 34px 40px; border-radius: 28px; background: var(--white); box-shadow: 0 0 0 1px var(--line); }\n.fact { padding: 34px 40px; border-radius: 28px; background: var(--navy); color: var(--white); }\n.tag { font-family: \"Poppins\", sans-serif; font-weight: 700; font-size: 22px; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 14px; }\n\n/* Veilige zones voor stories/reels: boven 250 px en onder 340 px vrij van tekst */\n.story-safe { position: absolute; top: 250px; bottom: 340px; left: var(--pad); right: var(--pad); }\n</style>\n<!-- feature-deur (Feature, nieuwe variant: beeld-eerst, A4-blad aan een deur, licht). Bron: publieke changelog 2026.15y `uren_print_1`\n     (onder Openingsuren een knop Afdrukken (A4); PDF met je logo, je huiskleur, je uren per dag en je komende uitzonderlijke sluitingsdagen;\n     uren wijzigen = in een paar tikken een nieuwe afdrukken) + 2026.15d `opening_hours` (per dag één tot drie blokken, uitzonderlijke\n     sluitingsdagen met een korte reden). Pizzeria Fiamma = landing.scene.horeca; uren en sluitingsdagen zijn demo-inhoud. -->\n<style>\n  .door { position:absolute; left:80px; top:420px; width:600px; height:1000px; border-radius:26px 26px 0 0; background:linear-gradient(90deg,#2B3566,#1D2552); box-shadow:inset 0 0 0 14px #3A4579; }\n  .glass { position:absolute; left:40px; right:40px; top:40px; height:720px; border-radius:14px; background:linear-gradient(160deg,#DDE6F4 0%,#B9C6E0 60%,#A9B7D6 100%); }\n  .knob { position:absolute; right:14px; top:800px; width:30px; height:110px; border-radius:15px; background:#C9CEE6; }\n  .sheet { position:absolute; left:36px; top:60px; width:448px; background:#fff; border-radius:4px; box-shadow:0 16px 30px -10px rgba(0,0,0,.35); padding:30px 30px 24px; color:var(--navy); transform:rotate(-1.5deg); }\n  .tape { position:absolute; width:110px; height:34px; background:rgba(255,236,200,.85); top:-14px; }\n  .band { height:12px; border-radius:6px; background:#C8402A; margin:12px 0 18px; }\n  .fl { font-family:Poppins; font-weight:700; font-size:30px; display:flex; align-items:center; gap:12px; }\n  .fl i { width:42px; height:42px; border-radius:50%; background:#C8402A; display:block; }\n  .d { display:flex; justify-content:space-between; font-size:16px; padding:7px 0; border-top:1px solid var(--line); }\n  .d b { font-weight:600; }\n  .d .x { color:var(--mute); }\n  .cl { margin-top:14px; padding:12px 14px; border-radius:10px; background:#FBEDE8; font-size:16px; line-height:1.45; }\n  .cl b { color:#C8402A; }\n</style>\n</head>\n<body>\n  <div class=\"blob soft\" style=\"width:820px;height:820px;right:-300px;top:500px\"></div>\n  <img class=\"logo tl\" src=\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/logo-navy.png\" alt=\"SellQo\">\n  <div style=\"position:absolute;left:var(--pad);right:var(--pad);top:180px\">\n    <h1 class=\"h h-m\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"50\">Dicht met de feestdagen?<br><span class=\"hl\">Hang het aan je deur.</span></h1>\n  </div>\n\n  <div class=\"door\">\n    <div class=\"glass\">\n      <div class=\"sheet\">\n        <span class=\"tape\" style=\"left:20px;transform:rotate(-8deg)\"></span><span class=\"tape\" style=\"right:20px;transform:rotate(7deg)\"></span>\n        <div class=\"fl\"><i></i>Pizzeria Fiamma</div>\n        <div class=\"band\"></div>\n        <div style=\"font-family:Poppins;font-weight:600;font-size:20px;margin-bottom:6px\">Openingsuren</div>\n        <div class=\"d\"><b>Maandag</b><span class=\"x\">gesloten</span></div>\n        <div class=\"d\"><b>Dinsdag</b><span>11:30–14:00 · 17:30–22:00</span></div>\n        <div class=\"d\"><b>Woensdag</b><span>11:30–14:00 · 17:30–22:00</span></div>\n        <div class=\"d\"><b>Donderdag</b><span>11:30–14:00 · 17:30–22:00</span></div>\n        <div class=\"d\"><b>Vrijdag</b><span>11:30–14:00 · 17:30–23:00</span></div>\n        <div class=\"d\"><b>Zaterdag</b><span>17:00–23:00</span></div>\n        <div class=\"d\"><b>Zondag</b><span>17:00–22:00</span></div>\n        <div class=\"cl\"><b>Uitzonderlijk gesloten</b><br>24 t.e.m. 26 december · kerstverlof<br>1 januari · nieuwjaar</div>\n      </div>\n    </div>\n    <div class=\"knob\"></div>\n  </div>\n\n  <div class=\"card tilt-r\" style=\"right:60px;top:600px;width:360px\">\n    <div class=\"ttl\">Openingsuren</div>\n    <div class=\"row\"><span>Uren per dag</span><span class=\"chip ok\">ingevuld</span></div>\n    <div class=\"row\"><span>Sluitingsdagen</span><span class=\"chip ok\">2</span></div>\n    <div class=\"btn\" style=\"width:100%;margin-top:12px\">Afdrukken (A4)</div>\n  </div>\n  <div class=\"toast\" style=\"right:60px;top:960px;width:360px\"><span class=\"tick\">✓</span>PDF met je logo en je huiskleur</div>\n\n  <div style=\"position:absolute;left:var(--pad);right:var(--pad);bottom:64px;display:flex;align-items:center;justify-content:flex-end;gap:24px\">\n    <span class=\"pill coral\" data-slot=\"cta\" data-label=\"Knop\" data-max=\"16\">sellqo.app/horeca</span>\n  </div>\n</body>\n</html>\n"}