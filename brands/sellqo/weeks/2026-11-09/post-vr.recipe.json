{"version":1,"width":1080,"height":1350,"html":"<!doctype html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"nx-size\" content=\"1080x1350\">\n<title>Buildlog: logo en merkkleur op één plek</title>\n<style>/* SellQo — huisstijl voor Instagram (posts/carrousels 1080x1350, stories/reels 1080x1920, LinkedIn 1200x1200).\n   Kleuren uit het logo: navy #00145B (primair) en koraal #FD7B5B (accent). Vriendelijk en rond, zoals het tasje.\n   Fonts: Poppins (titels) en Inter (tekst), beide OFL, lokaal in ./fonts.\n   Hoofdmotief: getrouwe UI-scènes (bestelling, factuur, kassa, keuken, ticket) met copy uit de echte app. */\n\n@font-face { font-family: \"Poppins\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/poppins-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"Poppins\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/poppins-latin-600-normal.woff2\") format(\"woff2\"); font-weight: 600; }\n@font-face { font-family: \"Poppins\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/poppins-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n@font-face { font-family: \"Poppins\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/poppins-latin-800-normal.woff2\") format(\"woff2\"); font-weight: 800; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/inter-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/inter-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/inter-latin-600-normal.woff2\") format(\"woff2\"); font-weight: 600; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/inter-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n\n:root {\n  --navy: #00145B;       /* primair */\n  --deep: #0A1033;       /* donkere achtergrond */\n  --deep-2: #141B47;     /* vlak op donker */\n  --coral: #FD7B5B;      /* accent */\n  --coral-soft: #FFE3DA;\n  --orange: #FF6933;     /* site-knop, spaarzaam */\n  --cream: #FFF7F2;      /* lichte achtergrond */\n  --white: #FFFFFF;\n  --mute: #8A93B8;       /* grijsblauw */\n  --line: rgba(0,20,91,.10);\n  --line-d: rgba(255,255,255,.12);\n  --green: #1FA971;      /* status \"klaar/betaald\" in UI-scènes */\n  --pad: 80px;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { width: 100%; height: 100%; }\nbody { background: var(--cream); color: var(--navy); font-family: \"Inter\", sans-serif; -webkit-font-smoothing: antialiased; overflow: hidden; position: relative; }\nbody.dark { background: var(--deep); color: var(--white); }\n\n/* Typografie */\n.h { font-family: \"Poppins\", sans-serif; font-weight: 700; line-height: 1.04; letter-spacing: -.02em; }\n.h-xl { font-size: 112px; }\n.h-l { font-size: 88px; }\n.h-m { font-size: 64px; }\n.h-s { font-size: 44px; }\n.lead { font-size: 34px; line-height: 1.4; font-weight: 500; }\n.body { font-size: 28px; line-height: 1.45; }\n.mute { color: var(--mute); }\n.coral { color: var(--coral); }\n.kicker { font-family: \"Poppins\", sans-serif; font-size: 24px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--coral); }\n.hl { background: linear-gradient(transparent 62%, var(--coral-soft) 62%); padding: 0 6px; margin: 0 -6px; }\nbody.dark .hl { background: none; color: var(--coral); }\n\n/* Logo */\n.logo { position: absolute; height: 64px; width: auto; }\n.logo.tl { top: 72px; left: var(--pad); }\n.logo.tr { top: 72px; right: var(--pad); }\n.logo.bl { bottom: 72px; left: var(--pad); }\n.logo.br { bottom: 72px; right: var(--pad); }\n\n/* Zachte vormen op de achtergrond (rond, zoals het tasje) */\n.blob { position: absolute; border-radius: 50%; }\n.blob.coral { background: var(--coral); }\n.blob.soft { background: var(--coral-soft); }\n.blob.navy { background: var(--navy); }\n.dots { position: absolute; background-image: radial-gradient(var(--line) 3px, transparent 3px); background-size: 34px 34px; }\nbody.dark .dots { background-image: radial-gradient(rgba(255,255,255,.09) 3px, transparent 3px); }\n\n/* UI-scène: kaartjes zoals in de app */\n.card { position: absolute; background: var(--white); border-radius: 28px; box-shadow: 0 30px 60px -20px rgba(0,20,91,.28), 0 0 0 1px var(--line); padding: 32px 36px; color: var(--navy); }\n.card.tilt-l { transform: rotate(-2.5deg); }\n.card.tilt-r { transform: rotate(2deg); }\n.card .ttl { font-family: \"Poppins\", sans-serif; font-weight: 600; font-size: 26px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }\n.card .row { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 16px 0; border-top: 1px solid var(--line); font-size: 24px; }\n.card .row:first-of-type { border-top: 0; }\n.card .row b { font-weight: 600; }\n.card .sub { font-size: 20px; color: var(--mute); margin-top: 4px; }\n.card .big { font-family: \"Poppins\", sans-serif; font-weight: 700; font-size: 56px; line-height: 1; }\n.chip { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: 999px; font-size: 19px; font-weight: 600; white-space: nowrap; }\n.chip.new { background: var(--coral-soft); color: #C9452A; }\n.chip.ok { background: #DDF5EA; color: #13804F; }\n.chip.blue { background: #E4E8F7; color: var(--navy); }\n.chip.dark { background: var(--navy); color: var(--white); }\n.btn { display: inline-flex; align-items: center; justify-content: center; padding: 18px 30px; border-radius: 16px; background: var(--orange); color: var(--white); font-weight: 600; font-size: 24px; }\n.toast { position: absolute; display: flex; align-items: center; gap: 16px; padding: 22px 30px; border-radius: 20px; background: var(--navy); color: var(--white); font-size: 24px; font-weight: 500; box-shadow: 0 24px 48px -16px rgba(0,20,91,.5); }\n.toast .tick { width: 36px; height: 36px; border-radius: 50%; background: var(--green); display: grid; place-items: center; font-weight: 700; font-size: 20px; }\n\n/* Pillen / CTA onderaan */\n.pill { display: inline-flex; align-items: center; gap: 14px; padding: 20px 32px; border-radius: 999px; font-size: 26px; font-weight: 600; font-family: \"Poppins\", sans-serif; }\n.pill.coral { background: var(--coral); color: var(--white); }\n.pill.navy { background: var(--navy); color: var(--white); }\n.pill.ghost { border: 2px solid var(--line); }\nbody.dark .pill.ghost { border-color: var(--line-d); }\n\n/* Genummerde stap (carrousels) */\n.step { width: 96px; height: 96px; border-radius: 50%; background: var(--coral); color: var(--white); display: grid; place-items: center; font-family: \"Poppins\", sans-serif; font-weight: 700; font-size: 44px; }\n.swipe { position: absolute; right: var(--pad); bottom: 80px; font-family: \"Poppins\", sans-serif; font-weight: 600; font-size: 24px; display: flex; align-items: center; gap: 12px; }\n.counter { position: absolute; right: var(--pad); top: 84px; font-family: \"Poppins\", sans-serif; font-weight: 600; font-size: 24px; color: var(--mute); }\n\n/* Mythe / feit */\n.myth { padding: 34px 40px; border-radius: 28px; background: var(--white); box-shadow: 0 0 0 1px var(--line); }\n.fact { padding: 34px 40px; border-radius: 28px; background: var(--navy); color: var(--white); }\n.tag { font-family: \"Poppins\", sans-serif; font-weight: 700; font-size: 22px; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 14px; }\n\n/* Veilige zones voor stories/reels: boven 250 px en onder 340 px vrij van tekst */\n.story-safe { position: absolute; top: 250px; bottom: 340px; left: var(--pad); right: var(--pad); }\n</style>\n<!-- buildlog-voorna (Build in public, nieuwe variant: voor/na in twee kolommen, donker). Bron: publieke changelog 2026.15d\n     `branding_one_place` (logo, favicon en merkkleur enkel onder Instellingen › Branding; gelden voor website, mails, facturen en\n     kassabonnen; gebruiken facturen of mails een ander logo of andere kleur, dan meldt Branding dat; bij opslaan krijgen ze allemaal\n     hetzelfde). Atelier Nord = demowinkel uit landing.scene.retail; het logo is een tekening. -->\n<style>\n  .col { position:absolute; top:470px; width:430px; height:640px; border-radius:30px; padding:30px; }\n  .col.voor { left:80px; background:var(--deep-2); box-shadow:0 0 0 2px var(--line-d); }\n  .col.na { right:80px; background:#fff; color:var(--navy); }\n  .col .tag { margin-bottom:22px; }\n  .it { display:flex; align-items:center; justify-content:space-between; gap:14px; padding:20px 22px; border-radius:18px; margin-bottom:16px; font-size:24px; font-weight:600; }\n  .voor .it { background:rgba(255,255,255,.06); color:#C9CEE6; }\n  .na .it { background:#F4F5FB; }\n  .mk { font-family:\"Poppins\",sans-serif; font-weight:800; font-size:22px; letter-spacing:.04em; padding:8px 14px; border-radius:10px; white-space:nowrap; }\n  .arrow { position:absolute; left:50%; top:760px; width:84px; height:84px; margin-left:-42px; border-radius:50%; background:var(--coral); color:#fff; display:grid; place-items:center; font-family:\"Poppins\"; font-weight:700; font-size:40px; z-index:2; box-shadow:0 14px 30px -10px rgba(253,123,91,.8); }\n</style>\n</head>\n<body class=\"dark\">\n  <div class=\"dots\" style=\"left:0;right:0;top:0;height:420px\"></div>\n  <img class=\"logo tl\" src=\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/logo-white.png\" alt=\"SellQo\">\n  <div style=\"position:absolute;left:var(--pad);right:var(--pad);top:190px\">\n    <div class=\"kicker\" style=\"margin-bottom:18px\" data-slot=\"kicker\" data-label=\"Bovenregel\" data-max=\"30\">Nieuw in SellQo</div>\n    <h1 class=\"h h-m\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"60\">Vier plekken.<br><span class=\"hl\">Eén logo.</span></h1>\n  </div>\n\n  <div class=\"col voor\">\n    <div class=\"tag\" style=\"color:var(--mute)\">Voor</div>\n    <div class=\"it\"><span>Website</span><span class=\"mk\" style=\"background:#2F6B4F;color:#fff\">ATELIER NORD</span></div>\n    <div class=\"it\"><span>Mails</span><span class=\"mk\" style=\"background:#B8572F;color:#fff\">atelier nord</span></div>\n    <div class=\"it\"><span>Facturen</span><span class=\"mk\" style=\"background:#6B6F80;color:#fff\">AN</span></div>\n    <div class=\"it\"><span>Kassabon</span><span class=\"mk\" style=\"background:#3A4C9A;color:#fff\">Atelier N.</span></div>\n    <p style=\"font-size:22px;color:var(--mute);margin-top:18px;line-height:1.4\">Branding meldt het als iets afwijkt.</p>\n  </div>\n  <div class=\"arrow\">→</div>\n  <div class=\"col na\">\n    <div class=\"tag\" style=\"color:var(--coral)\">Na</div>\n    <div class=\"it\"><span>Website</span><span class=\"mk\" style=\"background:#2F6B4F;color:#fff\">ATELIER NORD</span></div>\n    <div class=\"it\"><span>Mails</span><span class=\"mk\" style=\"background:#2F6B4F;color:#fff\">ATELIER NORD</span></div>\n    <div class=\"it\"><span>Facturen</span><span class=\"mk\" style=\"background:#2F6B4F;color:#fff\">ATELIER NORD</span></div>\n    <div class=\"it\"><span>Kassabon</span><span class=\"mk\" style=\"background:#2F6B4F;color:#fff\">ATELIER NORD</span></div>\n    <p style=\"font-size:22px;color:#4A557F;margin-top:18px;line-height:1.4\">Eén keer opslaan, overal hetzelfde.</p>\n  </div>\n\n  <div style=\"position:absolute;left:var(--pad);right:var(--pad);bottom:70px;display:flex;align-items:center;justify-content:space-between\">\n    <span class=\"body\" style=\"font-weight:500\" data-slot=\"tekst\" data-label=\"Tekst onder\" data-max=\"46\">Instellingen › Branding</span>\n    <span class=\"pill coral\" data-slot=\"cta\" data-label=\"Knop\" data-max=\"20\">sellqo.app/changelog</span>\n  </div>\n</body>\n</html>\n"}