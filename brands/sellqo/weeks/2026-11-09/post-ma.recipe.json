{"version":1,"width":1080,"height":1350,"html":"<!doctype html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"nx-size\" content=\"1080x1350\">\n<title>Feature: je menukaart afdrukken</title>\n<style>/* SellQo — huisstijl voor Instagram (posts/carrousels 1080x1350, stories/reels 1080x1920, LinkedIn 1200x1200).\n   Kleuren uit het logo: navy #00145B (primair) en koraal #FD7B5B (accent). Vriendelijk en rond, zoals het tasje.\n   Fonts: Poppins (titels) en Inter (tekst), beide OFL, lokaal in ./fonts.\n   Hoofdmotief: getrouwe UI-scènes (bestelling, factuur, kassa, keuken, ticket) met copy uit de echte app. */\n\n@font-face { font-family: \"Poppins\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/poppins-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"Poppins\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/poppins-latin-600-normal.woff2\") format(\"woff2\"); font-weight: 600; }\n@font-face { font-family: \"Poppins\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/poppins-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n@font-face { font-family: \"Poppins\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/poppins-latin-800-normal.woff2\") format(\"woff2\"); font-weight: 800; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/inter-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/inter-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/inter-latin-600-normal.woff2\") format(\"woff2\"); font-weight: 600; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/fonts/inter-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n\n:root {\n  --navy: #00145B;       /* primair */\n  --deep: #0A1033;       /* donkere achtergrond */\n  --deep-2: #141B47;     /* vlak op donker */\n  --coral: #FD7B5B;      /* accent */\n  --coral-soft: #FFE3DA;\n  --orange: #FF6933;     /* site-knop, spaarzaam */\n  --cream: #FFF7F2;      /* lichte achtergrond */\n  --white: #FFFFFF;\n  --mute: #8A93B8;       /* grijsblauw */\n  --line: rgba(0,20,91,.10);\n  --line-d: rgba(255,255,255,.12);\n  --green: #1FA971;      /* status \"klaar/betaald\" in UI-scènes */\n  --pad: 80px;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { width: 100%; height: 100%; }\nbody { background: var(--cream); color: var(--navy); font-family: \"Inter\", sans-serif; -webkit-font-smoothing: antialiased; overflow: hidden; position: relative; }\nbody.dark { background: var(--deep); color: var(--white); }\n\n/* Typografie */\n.h { font-family: \"Poppins\", sans-serif; font-weight: 700; line-height: 1.04; letter-spacing: -.02em; }\n.h-xl { font-size: 112px; }\n.h-l { font-size: 88px; }\n.h-m { font-size: 64px; }\n.h-s { font-size: 44px; }\n.lead { font-size: 34px; line-height: 1.4; font-weight: 500; }\n.body { font-size: 28px; line-height: 1.45; }\n.mute { color: var(--mute); }\n.coral { color: var(--coral); }\n.kicker { font-family: \"Poppins\", sans-serif; font-size: 24px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--coral); }\n.hl { background: linear-gradient(transparent 62%, var(--coral-soft) 62%); padding: 0 6px; margin: 0 -6px; }\nbody.dark .hl { background: none; color: var(--coral); }\n\n/* Logo */\n.logo { position: absolute; height: 64px; width: auto; }\n.logo.tl { top: 72px; left: var(--pad); }\n.logo.tr { top: 72px; right: var(--pad); }\n.logo.bl { bottom: 72px; left: var(--pad); }\n.logo.br { bottom: 72px; right: var(--pad); }\n\n/* Zachte vormen op de achtergrond (rond, zoals het tasje) */\n.blob { position: absolute; border-radius: 50%; }\n.blob.coral { background: var(--coral); }\n.blob.soft { background: var(--coral-soft); }\n.blob.navy { background: var(--navy); }\n.dots { position: absolute; background-image: radial-gradient(var(--line) 3px, transparent 3px); background-size: 34px 34px; }\nbody.dark .dots { background-image: radial-gradient(rgba(255,255,255,.09) 3px, transparent 3px); }\n\n/* UI-scène: kaartjes zoals in de app */\n.card { position: absolute; background: var(--white); border-radius: 28px; box-shadow: 0 30px 60px -20px rgba(0,20,91,.28), 0 0 0 1px var(--line); padding: 32px 36px; color: var(--navy); }\n.card.tilt-l { transform: rotate(-2.5deg); }\n.card.tilt-r { transform: rotate(2deg); }\n.card .ttl { font-family: \"Poppins\", sans-serif; font-weight: 600; font-size: 26px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }\n.card .row { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 16px 0; border-top: 1px solid var(--line); font-size: 24px; }\n.card .row:first-of-type { border-top: 0; }\n.card .row b { font-weight: 600; }\n.card .sub { font-size: 20px; color: var(--mute); margin-top: 4px; }\n.card .big { font-family: \"Poppins\", sans-serif; font-weight: 700; font-size: 56px; line-height: 1; }\n.chip { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: 999px; font-size: 19px; font-weight: 600; white-space: nowrap; }\n.chip.new { background: var(--coral-soft); color: #C9452A; }\n.chip.ok { background: #DDF5EA; color: #13804F; }\n.chip.blue { background: #E4E8F7; color: var(--navy); }\n.chip.dark { background: var(--navy); color: var(--white); }\n.btn { display: inline-flex; align-items: center; justify-content: center; padding: 18px 30px; border-radius: 16px; background: var(--orange); color: var(--white); font-weight: 600; font-size: 24px; }\n.toast { position: absolute; display: flex; align-items: center; gap: 16px; padding: 22px 30px; border-radius: 20px; background: var(--navy); color: var(--white); font-size: 24px; font-weight: 500; box-shadow: 0 24px 48px -16px rgba(0,20,91,.5); }\n.toast .tick { width: 36px; height: 36px; border-radius: 50%; background: var(--green); display: grid; place-items: center; font-weight: 700; font-size: 20px; }\n\n/* Pillen / CTA onderaan */\n.pill { display: inline-flex; align-items: center; gap: 14px; padding: 20px 32px; border-radius: 999px; font-size: 26px; font-weight: 600; font-family: \"Poppins\", sans-serif; }\n.pill.coral { background: var(--coral); color: var(--white); }\n.pill.navy { background: var(--navy); color: var(--white); }\n.pill.ghost { border: 2px solid var(--line); }\nbody.dark .pill.ghost { border-color: var(--line-d); }\n\n/* Genummerde stap (carrousels) */\n.step { width: 96px; height: 96px; border-radius: 50%; background: var(--coral); color: var(--white); display: grid; place-items: center; font-family: \"Poppins\", sans-serif; font-weight: 700; font-size: 44px; }\n.swipe { position: absolute; right: var(--pad); bottom: 80px; font-family: \"Poppins\", sans-serif; font-weight: 600; font-size: 24px; display: flex; align-items: center; gap: 12px; }\n.counter { position: absolute; right: var(--pad); top: 84px; font-family: \"Poppins\", sans-serif; font-weight: 600; font-size: 24px; color: var(--mute); }\n\n/* Mythe / feit */\n.myth { padding: 34px 40px; border-radius: 28px; background: var(--white); box-shadow: 0 0 0 1px var(--line); }\n.fact { padding: 34px 40px; border-radius: 28px; background: var(--navy); color: var(--white); }\n.tag { font-family: \"Poppins\", sans-serif; font-weight: 700; font-size: 22px; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 14px; }\n\n/* Veilige zones voor stories/reels: boven 250 px en onder 340 px vrij van tekst */\n.story-safe { position: absolute; top: 250px; bottom: 340px; left: var(--pad); right: var(--pad); }\n</style>\n<!-- feature-print (pijler Feature, nieuwe variant, beeld eerst: het afgedrukte A5-boekje neemt het grootste deel in).\n     Bron: publieke changelog 2026.15k `menu_card_print` (knop Afdrukken op de Kaart; A5-boekje, losse A4-pagina's of boekje met foto\n     op de kaft; PDF in de kleuren en met het logo van je zaak; prijzen, omschrijvingen, allergenen als nummers met legende;\n     achteraan adres, openingsuren en QR-code naar je online kaart). Pizzeria Fiamma + Diavola € 21,00 = landing.scene.horeca;\n     andere gerechten zijn demo-inhoud. QR is een tekening, geen echte code. -->\n<style>\n  .stage { position:absolute; left:0; right:0; top:390px; height:760px; }\n  .page { position:absolute; background:#fff; border-radius:10px; box-shadow:0 40px 70px -24px rgba(0,20,91,.38), 0 0 0 1px var(--line); }\n  .cover { left:110px; top:40px; width:400px; height:566px; transform:rotate(-6deg); background:#7A1E14; color:#FFF3E6; padding:46px 40px; display:flex; flex-direction:column; justify-content:space-between; }\n  .cover .nm { font-family:\"Poppins\",sans-serif; font-weight:800; font-size:54px; line-height:1; letter-spacing:-.01em; }\n  .cover .sm { font-size:18px; letter-spacing:.2em; text-transform:uppercase; opacity:.8; }\n  .cover .ring { width:150px; height:150px; border-radius:50%; border:6px solid #FFB25B; display:grid; place-items:center; font-family:\"Poppins\"; font-weight:700; font-size:22px; color:#FFB25B; letter-spacing:.12em; }\n  .inside { left:420px; top:70px; width:540px; height:640px; transform:rotate(3deg); padding:46px 46px 36px; color:#2A1410; }\n  .inside .cat { font-family:\"Poppins\",sans-serif; font-weight:700; font-size:22px; letter-spacing:.18em; text-transform:uppercase; color:#7A1E14; margin:4px 0 14px; }\n  .dish { display:flex; justify-content:space-between; gap:16px; padding:11px 0; border-bottom:1px dashed rgba(122,30,20,.25); }\n  .dish b { font-family:\"Poppins\",sans-serif; font-weight:600; font-size:24px; }\n  .dish .d { font-size:17px; color:#7B6A66; margin-top:3px; }\n  .dish .p { font-family:\"Poppins\",sans-serif; font-weight:600; font-size:22px; white-space:nowrap; }\n  .al { display:inline-block; font-size:14px; font-weight:700; color:#7A1E14; background:#F7E6E1; border-radius:6px; padding:1px 7px; margin-left:6px; vertical-align:3px; }\n  .legend { position:absolute; left:46px; right:46px; bottom:30px; font-size:14px; color:#7B6A66; display:flex; justify-content:space-between; align-items:flex-end; }\n  .tabs { position:absolute; left:var(--pad); right:var(--pad); top:1165px; display:flex; gap:14px; flex-wrap:wrap; }\n  .tabs .chip { font-size:22px; padding:12px 20px; }\n</style>\n</head>\n<body>\n  <div class=\"blob soft\" style=\"width:900px;height:900px;left:-300px;top:420px\"></div>\n  <div class=\"dots\" style=\"right:0;width:520px;top:380px;height:520px;opacity:.8\"></div>\n  <img class=\"logo tl\" src=\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/sellqo/logo-navy.png\" alt=\"SellQo\">\n  <div style=\"position:absolute;left:var(--pad);right:var(--pad);top:180px\">\n    <h1 class=\"h h-m\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"60\">Je kaart op papier.<br><span class=\"hl\">In je eigen kleuren.</span></h1>\n  </div>\n\n  <div class=\"stage\">\n    <div class=\"page cover\">\n      <div class=\"sm\">Menukaart</div>\n      <div class=\"ring\">FORNO</div>\n      <div><div class=\"nm\">Pizzeria<br>Fiamma</div></div>\n    </div>\n    <div class=\"page inside\">\n      <div class=\"cat\">Pizza</div>\n      <div class=\"dish\"><div><b>Margherita<span class=\"al\">1 · 7</span></b><div class=\"d\">tomaat, mozzarella, basilicum</div></div><span class=\"p\">€ 13,00</span></div>\n      <div class=\"dish\"><div><b>Diavola<span class=\"al\">1 · 7</span></b><div class=\"d\">groot · + burrata</div></div><span class=\"p\">€ 21,00</span></div>\n      <div class=\"dish\"><div><b>Funghi<span class=\"al\">1 · 7</span></b><div class=\"d\">champignons, tijm</div></div><span class=\"p\">€ 15,50</span></div>\n      <div class=\"cat\" style=\"margin-top:22px\">Dessert</div>\n      <div class=\"dish\"><div><b>Tiramisu<span class=\"al\">1 · 3 · 7</span></b><div class=\"d\">huisgemaakt</div></div><span class=\"p\">€ 7,50</span></div>\n      <div class=\"legend\"><div>Allergenen: 1 gluten · 3 eieren · 7 melk<br>Open di–zo · Kaart online: scan de code</div><svg class=\"qr\" viewBox=\"-8 -8 100 100\" width=\"92\" height=\"92\"><rect x=\"-8\" y=\"-8\" width=\"100\" height=\"100\" fill=\"#fff\"/><rect x=\"32\" y=\"0\" width=\"4\" height=\"4\" fill=\"#2A1410\"/><rect x=\"36\" y=\"0\" width=\"4\" height=\"4\" fill=\"#2A1410\"/><rect x=\"44\" y=\"0\" width=\"4\" height=\"4\" fill=\"#2A1410\"/><rect x=\"32\" y=\"4\" width=\"4\" height=\"4\" fill=\"#2A1410\"/><rect x=\"36\" y=\"4\" width=\"4\" height=\"4\" fill=\"#2A1410\"/><rect x=\"44\" y=\"4\" width=\"4\" height=\"4\" fill=\"#2A1410\"/><rect x=\"48\" y=\"4\" width=\"4\" height=\"4\" fill=\"#2A1410\"/><rect x=\"32\" y=\"8\" width=\"4\" height=\"4\" fill=\"#2A1410\"/><rect x=\"36\" y=\"8\" width=\"4\" height=\"4\" fill=\"#2A1410\"/><rect x=\"40\" y=\"8\" width=\"4\" height=\"4\" fill=\"#2A1410\"/><rect x=\"48\" y=\"8\" width=\"4\" height=\"4\" fill=\"#2A1410\"/><rect x=\"32\" y=\"12\" width=\"4\" height=\"4\" fill=\"#2A1410\"/><rect x=\"48\" y=\"12\" width=\"4\" height=\"4\" fill=\"#2A1410\"/><rect x=\"36\" y=\"16\" width=\"4\" height=\"4\" fill=\"#2A1410\"/><rect x=\"44\" y=\"16\" width=\"4\" height=\"4\" fill=\"#2A1410\"/><rect x=\"48\" y=\"16\" width=\"4\" height=\"4\" fill=\"#2A1410\"/><rect x=\"32\" y=\"20\" width=\"4\" height=\"4\" fill=\"#2A1410\"/><rect x=\"36\" y=\"20\" width=\"4\" height=\"4\" fill=\"#2A1410\"/><rect x=\"44\" y=\"20\" width=\"4\" height=\"4\" fill=\"#2A1410\"/><rect x=\"