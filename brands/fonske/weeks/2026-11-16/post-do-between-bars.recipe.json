{"version":1,"width":1080,"height":1350,"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"nx-size\" content=\"1080x1350\">\n<title>Between bar one and the finale</title>\n<style>/* The Fonske Crawl — huisstijl voor Instagram (posts 1080x1350, stories/reels 1080x1920).\n   Afgeleid van fonskecrawl.com (repo fonske-crawl-hq, src/styles.css): warm bijna-zwart, amber/goud, crème.\n   Fonts: Bebas Neue (titels) en Space Grotesk (tekst), beide OFL, lokaal in ./fonts. */\n\n@font-face { font-family: \"Bebas Neue\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/bebas-neue-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n\n:root {\n  --ink: #110C08;        /* achtergrond (site --background) */\n  --card: #1D1711;       /* vlakken */\n  --line: rgba(244,241,236,.14);\n  --amber: #F4A434;      /* primair (site --primary) */\n  --gold-a: #F6CB6A;     /* goudverloop begin */\n  --gold-b: #E58A2A;     /* goudverloop eind */\n  --red: #D45A4F;        /* accent, spaarzaam (site --accent): deadlines */\n  --cream: #F4F1EC;      /* tekst */\n  --mute: #B7A894;\n  --pad: 80px;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { width: 100%; height: 100%; }\nbody {\n  background:\n    radial-gradient(110% 70% at 50% 0%, rgba(150,95,30,.38) 0%, transparent 62%),\n    radial-gradient(70% 50% at 100% 100%, rgba(120,70,20,.22) 0%, transparent 70%),\n    linear-gradient(180deg, #17110B 0%, var(--ink) 100%);\n  color: var(--cream);\n  font-family: \"Space Grotesk\", sans-serif; -webkit-font-smoothing: antialiased;\n  overflow: hidden; position: relative;\n}\n.grain { position: absolute; inset: 0; opacity: .14; mix-blend-mode: overlay; pointer-events: none;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>\"); }\n\n/* Typografie */\n.display { font-family: \"Bebas Neue\", sans-serif; font-weight: 400; line-height: .88; letter-spacing: .01em; text-transform: uppercase; }\n.d-xxl { font-size: 260px; }\n.d-xl { font-size: 190px; }\n.d-l  { font-size: 140px; }\n.d-m  { font-size: 96px; }\n.d-s  { font-size: 60px; }\n.gold { background: linear-gradient(100deg, var(--gold-a) 0%, var(--gold-b) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }\n.amber { color: var(--amber); }\n.red { color: var(--red); }\n.lead { font-size: 38px; line-height: 1.32; font-weight: 500; color: rgba(244,241,236,.92); }\n.body { font-size: 30px; line-height: 1.45; color: rgba(244,241,236,.82); }\n.kicker { font-size: 24px; font-weight: 700; letter-spacing: .26em; text-transform: uppercase; color: var(--amber); }\n.small { font-size: 24px; letter-spacing: .08em; color: var(--mute); }\n\n/* Logo */\n.mark { position: absolute; height: auto; }\n.wordmark { font-family: \"Bebas Neue\", sans-serif; font-size: 40px; letter-spacing: .06em; color: var(--cream); }\n.brandrow { position: absolute; display: flex; align-items: center; gap: 18px; }\n.brandrow img { width: 58px; height: auto; }\n\n/* Info-rijen (wanneer / waar / prijs) */\n.rows { display: grid; }\n.row { display: flex; align-items: baseline; gap: 28px; padding: 24px 0; border-top: 2px solid var(--line); }\n.row:last-child { border-bottom: 2px solid var(--line); }\n.row .k { min-width: 190px; font-size: 24px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--mute); }\n.row .v { font-family: \"Bebas Neue\", sans-serif; font-size: 64px; line-height: 1; color: var(--cream); }\n\n/* Genummerde stappen */\n.step { display: flex; gap: 34px; align-items: flex-start; }\n.step .n { font-family: \"Bebas Neue\", sans-serif; font-size: 150px; line-height: .78; color: transparent; -webkit-text-stroke: 2px var(--amber); min-width: 110px; }\n.step .t { font-family: \"Bebas Neue\", sans-serif; font-size: 66px; line-height: .95; text-transform: uppercase; }\n.step .s { font-size: 28px; line-height: 1.4; color: rgba(244,241,236,.78); margin-top: 10px; }\n\n/* Prijs, pil en ticket-stub */\n.pill { display: inline-flex; align-items: center; gap: 14px; padding: 20px 32px; border-radius: 999px; font-size: 28px; font-weight: 700; }\n.pill.amber { background: var(--amber); color: var(--ink); }\n.pill.ghost { border: 2px solid var(--line); color: var(--cream); }\n.stub { display: flex; align-items: stretch; border: 2px dashed rgba(244,164,52,.55); border-radius: 28px; overflow: hidden; }\n.stub .p { padding: 26px 36px; font-family: \"Bebas Neue\", sans-serif; font-size: 120px; line-height: .9; background: rgba(244,164,52,.1); }\n.stub .i { padding: 28px 34px; display: flex; flex-direction: column; justify-content: center; gap: 8px; border-left: 2px dashed rgba(244,164,52,.55); }\n.strike-none { text-decoration: none; }\n\n/* Stories met een link-sticker: laat rond y 1300–1560 een vrije strook (geen tekst), daar komt de sticker. */\n\n/* Veilige zones voor stories/reels: boven 250 px en onder 340 px vrij van tekst */\n.story-safe { position: absolute; top: 250px; bottom: 340px; left: var(--pad); right: var(--pad); }\n</style>\n<!-- Foto + tekening. Crawlfoto b1323f66 (crawl 01, 24-10, gepubliceerd): twee crawlers aan de bar, lachend, glas in de hand (geen close-up van drinken). Lijntekening cheers in donkere lijn. -->\n<style>\n\nbody.v-cream { background:#F4F1EC; color:#110C08; }\n.v-cream .kicker { color:#B5651D; }\n.snap { position:absolute; left:120px; top:250px; width:620px; height:860px; background:#fff; padding:26px 26px 110px; box-shadow:0 30px 60px rgba(17,12,8,.22); transform:rotate(-3.5deg); }\n.snap img { width:100%; height:100%; object-fit:cover; object-position:50% 58%; display:block; }\n.snap .cap { position:absolute; left:30px; right:30px; bottom:30px; font-family:\"Bebas Neue\"; font-size:48px; color:#110C08; letter-spacing:.03em; }\n.side { position:absolute; left:640px; right:60px; top:560px; display:flex; flex-direction:column; gap:22px; transform:rotate(2deg); }\n.side h1 { font-size:108px; color:#110C08; }\n\n</style>\n</head>\n<body class=\"v-cream\">\n  <div class=\"brandrow\" style=\"left:var(--pad); top:80px\"><img src=\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/logo-mark.png\" alt=\"\" style=\"filter:brightness(0)\"><span class=\"wordmark\" style=\"color:#110C08\">The Fonske Crawl</span></div>\n  <div class=\"kicker\" style=\"position:absolute; right:var(--pad); top:100px\" data-slot=\"kicker\" data-label=\"Kicker\" data-max=\"20\">Crawl 01 &middot; 24 Oct</div>\n  <div class=\"snap\"><img src=\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/photos/2026-10-24/b1323f66-591c-4966-876e-a1e9fdd71fae.jpg\" alt=\"\"><div class=\"cap\" data-slot=\"onderschrift\" data-label=\"Onderschrift\" data-max=\"26\">Leuven, 24 October</div></div>\n  <div class=\"side\" style=\"background:#F4F1EC; padding:34px 30px; border-radius:24px; box-shadow:0 20px 40px rgba(17,12,8,.12)\">\n    <div class=\"kicker\" data-slot=\"k2\" data-label=\"Boven titel\" data-max=\"18\">Somewhere</div>\n    <h1 class=\"display\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"40\">Between<br>bar one<br>and the<br><span style=\"color:#E58A2A\">finale.</span></h1>\n  </div>\n<svg style=\"position:absolute; left:560px; top:1090px; width:420px; height:240px\" preserveAspectRatio=\"xMidYMid meet\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1000 700\">\n  \n  <defs>\n    <linearGradient id=\"cheers-bierc\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#F6CB6A\"/><stop offset=\"1\" stop-color=\"#E58A2A\"/></linearGradient>\n  </defs>\n  <g stroke=\"#110C08\" stroke-width=\"9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <g transform=\"translate(300 380) rotate(-14)\">\n      <path d=\"M-95 -170 L95 -170 L75 230 L-75 230 Z\" fill=\"url(#cheers-bierc)\"/>\n      <path d=\"M-100 -170 Q-80 -215 -40 -195 Q0 -235 40 -195 Q80 -215 100 -170 Z\" fill=\"#FFFFFF\"/>\n      <path d=\"M95 -90 Q170 -80 160 20 Q150 100 85 95\" fill=\"none\"/>\n    </g>\n    <g transform=\"translate(520 430)\">\n      <path d=\"M-55 -110 L55 -110 L42 120 L-42 120 Z\" fill=\"#F4A434\"/>\n      <path d=\"M-50 -60 L50 -60\" fill=\"none\" opacity=\".5\"/>\n    </g>\n    <g transform=\"translate(730 390) rotate(14)\">\n      <path d=\"M-80 -150 L80 -150 L60 220 L-60 220 Z\" fill=\"#FFFFFF\"/>\n      <path d=\"M-74 -40 L74 -40\" fill=\"none\"/>\n      <path d=\"M20 -150 L60 -280 L110 -290\" fill=\"none\"/>\n      <circle cx=\"-20\" cy=\"40\" r=\"16\" fill=\"none\" stroke-width=\"6\"/><circle cx=\"25\" cy=\"110\" r=\"12\" fill=\"none\" stroke-width=\"6\"/>\n    </g>\n  </g>\n  <g stroke=\"#E58A2A\" stroke-width=\"8\" stroke-linecap=\"round\">\n    <path d=\"M420 170 L405 115\"/><path d=\"M520 150 L520 90\"/><path d=\"M620 170 L640 115\"/>\n  </g>\n</svg>\n\n</body>\n</html>\n"}