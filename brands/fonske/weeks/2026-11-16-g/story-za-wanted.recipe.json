{"version":1,"width":1080,"height":1920,"html":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"nx-size\" content=\"1080x1920\">\n<title>Wanted: crawlers</title><style>/* The Fonske Crawl — huisstijl voor Instagram (posts 1080x1350, stories/reels 1080x1920).\n   Afgeleid van fonskecrawl.com (repo fonske-crawl-hq, src/styles.css): warm bijna-zwart, amber/goud, crème.\n   Fonts: Bebas Neue (titels) en Space Grotesk (tekst), beide OFL, lokaal in ./fonts. */\n\n@font-face { font-family: \"Bebas Neue\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/bebas-neue-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n\n:root {\n  --ink: #110C08;        /* achtergrond (site --background) */\n  --card: #1D1711;       /* vlakken */\n  --line: rgba(244,241,236,.14);\n  --amber: #F4A434;      /* primair (site --primary) */\n  --gold-a: #F6CB6A;     /* goudverloop begin */\n  --gold-b: #E58A2A;     /* goudverloop eind */\n  --red: #D45A4F;        /* accent, spaarzaam (site --accent): deadlines */\n  --cream: #F4F1EC;      /* tekst */\n  --mute: #B7A894;\n  --pad: 80px;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { width: 100%; height: 100%; }\nbody {\n  background:\n    radial-gradient(110% 70% at 50% 0%, rgba(150,95,30,.38) 0%, transparent 62%),\n    radial-gradient(70% 50% at 100% 100%, rgba(120,70,20,.22) 0%, transparent 70%),\n    linear-gradient(180deg, #17110B 0%, var(--ink) 100%);\n  color: var(--cream);\n  font-family: \"Space Grotesk\", sans-serif; -webkit-font-smoothing: antialiased;\n  overflow: hidden; position: relative;\n}\n.grain { position: absolute; inset: 0; opacity: .14; mix-blend-mode: overlay; pointer-events: none;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>\"); }\n\n/* Typografie */\n.display { font-family: \"Bebas Neue\", sans-serif; font-weight: 400; line-height: .88; letter-spacing: .01em; text-transform: uppercase; }\n.d-xxl { font-size: 260px; }\n.d-xl { font-size: 190px; }\n.d-l  { font-size: 140px; }\n.d-m  { font-size: 96px; }\n.d-s  { font-size: 60px; }\n.gold { background: linear-gradient(100deg, var(--gold-a) 0%, var(--gold-b) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }\n.amber { color: var(--amber); }\n.red { color: var(--red); }\n.lead { font-size: 38px; line-height: 1.32; font-weight: 500; color: rgba(244,241,236,.92); }\n.body { font-size: 30px; line-height: 1.45; color: rgba(244,241,236,.82); }\n.kicker { font-size: 24px; font-weight: 700; letter-spacing: .26em; text-transform: uppercase; color: var(--amber); }\n.small { font-size: 24px; letter-spacing: .08em; color: var(--mute); }\n\n/* Logo */\n.mark { position: absolute; height: auto; }\n.wordmark { font-family: \"Bebas Neue\", sans-serif; font-size: 40px; letter-spacing: .06em; color: var(--cream); }\n.brandrow { position: absolute; display: flex; align-items: center; gap: 18px; }\n.brandrow img { width: 58px; height: auto; }\n\n/* Info-rijen (wanneer / waar / prijs) */\n.rows { display: grid; }\n.row { display: flex; align-items: baseline; gap: 28px; padding: 24px 0; border-top: 2px solid var(--line); }\n.row:last-child { border-bottom: 2px solid var(--line); }\n.row .k { min-width: 190px; font-size: 24px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--mute); }\n.row .v { font-family: \"Bebas Neue\", sans-serif; font-size: 64px; line-height: 1; color: var(--cream); }\n\n/* Genummerde stappen */\n.step { display: flex; gap: 34px; align-items: flex-start; }\n.step .n { font-family: \"Bebas Neue\", sans-serif; font-size: 150px; line-height: .78; color: transparent; -webkit-text-stroke: 2px var(--amber); min-width: 110px; }\n.step .t { font-family: \"Bebas Neue\", sans-serif; font-size: 66px; line-height: .95; text-transform: uppercase; }\n.step .s { font-size: 28px; line-height: 1.4; color: rgba(244,241,236,.78); margin-top: 10px; }\n\n/* Prijs, pil en ticket-stub */\n.pill { display: inline-flex; align-items: center; gap: 14px; padding: 20px 32px; border-radius: 999px; font-size: 28px; font-weight: 700; }\n.pill.amber { background: var(--amber); color: var(--ink); }\n.pill.ghost { border: 2px solid var(--line); color: var(--cream); }\n.stub { display: flex; align-items: stretch; border: 2px dashed rgba(244,164,52,.55); border-radius: 28px; overflow: hidden; }\n.stub .p { padding: 26px 36px; font-family: \"Bebas Neue\", sans-serif; font-size: 120px; line-height: .9; background: rgba(244,164,52,.1); }\n.stub .i { padding: 28px 34px; display: flex; flex-direction: column; justify-content: center; gap: 8px; border-left: 2px dashed rgba(244,164,52,.55); }\n.strike-none { text-decoration: none; }\n\n/* Stories met een link-sticker: laat rond y 1300–1560 een vrije strook (geen tekst), daar komt de sticker. */\n\n/* Veilige zones voor stories/reels: boven 250 px en onder 340 px vrij van tekst */\n.story-safe { position: absolute; top: 250px; bottom: 340px; left: var(--pad); right: var(--pad); }\n</style>\n<!-- genre: wanted (I). Poll-sticker in het lege kader (y ±820–1180). Feiten live: 27-11, 21:00, the Totem. -->\n<style>\nbody{background:#2a1f15}\n.wall{position:absolute;inset:0;background:repeating-linear-gradient(0deg,#2f2318 0 90px,#271c12 90px 96px),repeating-linear-gradient(90deg,transparent 0 180px,rgba(0,0,0,.25) 180px 186px)}\n.poster{position:absolute;left:90px;right:90px;top:250px;bottom:330px;background:#efe3c8;transform:rotate(1.5deg);box-shadow:16px 20px 0 rgba(0,0,0,.4);color:#2b1d12;text-align:center;padding:60px 60px}\n.poster::before,.poster::after{content:\"\";position:absolute;top:24px;width:26px;height:26px;border-radius:50%;background:#8a6a3d}\n.poster::before{left:24px}.poster::after{right:24px}\nh1{font:400 220px/.8 \"Bebas Neue\";letter-spacing:.02em;margin:0}\nh2{font:400 90px/.9 \"Bebas Neue\";letter-spacing:.06em;margin:10px 0 30px;color:#9a3b2f}\n.frame{height:380px;border:6px solid #2b1d12;margin:0 30px;display:flex;align-items:flex-end;justify-content:center;padding-bottom:16px;font:700 22px \"Space Grotesk\";letter-spacing:.2em;text-transform:uppercase;color:#7a6650}\n.last{font:700 36px/1.3 \"Space Grotesk\";margin-top:34px}\n.rew{font:400 56px/1 \"Bebas Neue\";letter-spacing:.04em;margin-top:26px;color:#9a3b2f}\n.small{font:500 24px \"Space Grotesk\";margin-top:14px;color:#6b5a46}\n</style></head><body><div class=\"wall\"></div>\n<div class=\"poster\"><h1>Wanted</h1><h2 data-slot=\"titel\" data-label=\"Title\" data-max=\"20\">Crawlers</h2>\n<div class=\"frame\">your crew here</div>\n<div class=\"last\">Last seen: The Totem, Ladeuzeplein<br>Friday 27 November, 21:00</div>\n<div class=\"rew\">Reward: four bars + the Oude Markt</div>\n<div class=\"small\">18+ with ID · The Fonske Crawl</div></div>\n</body></html>\n"}