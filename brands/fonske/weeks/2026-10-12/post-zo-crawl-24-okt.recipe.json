{"version":1,"width":1080,"height":1350,"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"nx-size\" content=\"1080x1350\">\n<title>Crawl 24 Oct</title>\n<style>/* The Fonske Crawl — huisstijl voor Instagram (posts 1080x1350, stories/reels 1080x1920).\n   Afgeleid van fonskecrawl.com (repo fonske-crawl-hq, src/styles.css): warm bijna-zwart, amber/goud, crème.\n   Fonts: Bebas Neue (titels) en Space Grotesk (tekst), beide OFL, lokaal in ./fonts. */\n\n@font-face { font-family: \"Bebas Neue\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/bebas-neue-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n\n:root {\n  --ink: #110C08;        /* achtergrond (site --background) */\n  --card: #1D1711;       /* vlakken */\n  --line: rgba(244,241,236,.14);\n  --amber: #F4A434;      /* primair (site --primary) */\n  --gold-a: #F6CB6A;     /* goudverloop begin */\n  --gold-b: #E58A2A;     /* goudverloop eind */\n  --red: #D45A4F;        /* accent, spaarzaam (site --accent): deadlines */\n  --cream: #F4F1EC;      /* tekst */\n  --mute: #B7A894;\n  --pad: 80px;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { width: 100%; height: 100%; }\nbody {\n  background:\n    radial-gradient(110% 70% at 50% 0%, rgba(150,95,30,.38) 0%, transparent 62%),\n    radial-gradient(70% 50% at 100% 100%, rgba(120,70,20,.22) 0%, transparent 70%),\n    linear-gradient(180deg, #17110B 0%, var(--ink) 100%);\n  color: var(--cream);\n  font-family: \"Space Grotesk\", sans-serif; -webkit-font-smoothing: antialiased;\n  overflow: hidden; position: relative;\n}\n.grain { position: absolute; inset: 0; opacity: .14; mix-blend-mode: overlay; pointer-events: none;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>\"); }\n\n/* Typografie */\n.display { font-family: \"Bebas Neue\", sans-serif; font-weight: 400; line-height: .88; letter-spacing: .01em; text-transform: uppercase; }\n.d-xxl { font-size: 260px; }\n.d-xl { font-size: 190px; }\n.d-l  { font-size: 140px; }\n.d-m  { font-size: 96px; }\n.d-s  { font-size: 60px; }\n.gold { background: linear-gradient(100deg, var(--gold-a) 0%, var(--gold-b) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }\n.amber { color: var(--amber); }\n.red { color: var(--red); }\n.lead { font-size: 38px; line-height: 1.32; font-weight: 500; color: rgba(244,241,236,.92); }\n.body { font-size: 30px; line-height: 1.45; color: rgba(244,241,236,.82); }\n.kicker { font-size: 24px; font-weight: 700; letter-spacing: .26em; text-transform: uppercase; color: var(--amber); }\n.small { font-size: 24px; letter-spacing: .08em; color: var(--mute); }\n\n/* Logo */\n.mark { position: absolute; height: auto; }\n.wordmark { font-family: \"Bebas Neue\", sans-serif; font-size: 40px; letter-spacing: .06em; color: var(--cream); }\n.brandrow { position: absolute; display: flex; align-items: center; gap: 18px; }\n.brandrow img { width: 58px; height: auto; }\n\n/* Info-rijen (wanneer / waar / prijs) */\n.rows { display: grid; }\n.row { display: flex; align-items: baseline; gap: 28px; padding: 24px 0; border-top: 2px solid var(--line); }\n.row:last-child { border-bottom: 2px solid var(--line); }\n.row .k { min-width: 190px; font-size: 24px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--mute); }\n.row .v { font-family: \"Bebas Neue\", sans-serif; font-size: 64px; line-height: 1; color: var(--cream); }\n\n/* Genummerde stappen */\n.step { display: flex; gap: 34px; align-items: flex-start; }\n.step .n { font-family: \"Bebas Neue\", sans-serif; font-size: 150px; line-height: .78; color: transparent; -webkit-text-stroke: 2px var(--amber); min-width: 110px; }\n.step .t { font-family: \"Bebas Neue\", sans-serif; font-size: 66px; line-height: .95; text-transform: uppercase; }\n.step .s { font-size: 28px; line-height: 1.4; color: rgba(244,241,236,.78); margin-top: 10px; }\n\n/* Prijs, pil en ticket-stub */\n.pill { display: inline-flex; align-items: center; gap: 14px; padding: 20px 32px; border-radius: 999px; font-size: 28px; font-weight: 700; }\n.pill.amber { background: var(--amber); color: var(--ink); }\n.pill.ghost { border: 2px solid var(--line); color: var(--cream); }\n.stub { display: flex; align-items: stretch; border: 2px dashed rgba(244,164,52,.55); border-radius: 28px; overflow: hidden; }\n.stub .p { padding: 26px 36px; font-family: \"Bebas Neue\", sans-serif; font-size: 120px; line-height: .9; background: rgba(244,164,52,.1); }\n.stub .i { padding: 28px 34px; display: flex; flex-direction: column; justify-content: center; gap: 8px; border-left: 2px dashed rgba(244,164,52,.55); }\n.strike-none { text-decoration: none; }\n\n/* Stories met een link-sticker: laat rond y 1300–1560 een vrije strook (geen tekst), daar komt de sticker. */\n\n/* Veilige zones voor stories/reels: boven 250 px en onder 340 px vrij van tekst */\n.story-safe { position: absolute; top: 250px; bottom: 340px; left: var(--pad); right: var(--pad); }\n</style>\n<!-- Aankondiging. SellQo event 7ae8364e: 24-10 21:00, Ladeuzeplein, The Totem, early bird €19 tot 23-10, daarna €25. Illustratie: totem.svg -->\n<style>\nbody.v-night { background: #110C08; }\n.v-night .info{position:absolute; left:var(--pad); bottom:70px; display:flex; flex-direction:column; gap:16px; padding:34px 40px; background:rgba(17,12,8,.9); border:2px solid rgba(244,164,52,.45); border-radius:28px; box-shadow:0 20px 60px rgba(0,0,0,.5)}\n</style>\n</head>\n<body class=\"v-night\">\n  <svg style=\"position:absolute; right:-40px; bottom:0; width:900px; height:990px\" preserveAspectRatio=\"xMidYMax meet\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1000 1100\">\n  \n  <defs>\n    <radialGradient id=\"glow\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n      <stop offset=\"0\" stop-color=\"#F4A434\" stop-opacity=\".55\"/>\n      <stop offset=\"1\" stop-color=\"#F4A434\" stop-opacity=\"0\"/>\n    </radialGradient>\n    <linearGradient id=\"shell\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n      <stop offset=\"0\" stop-color=\"#7EE0A6\"/>\n      <stop offset=\".45\" stop-color=\"#1E9E6A\"/>\n      <stop offset=\"1\" stop-color=\"#0B4D38\"/>\n    </linearGradient>\n    <linearGradient id=\"win\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n      <stop offset=\"0\" stop-color=\"#F6CB6A\"/>\n      <stop offset=\"1\" stop-color=\"#E58A2A\"/>\n    </linearGradient>\n  </defs>\n\n  \n  <g fill=\"#F4F1EC\" opacity=\".7\">\n    <circle cx=\"90\" cy=\"120\" r=\"3\"/><circle cx=\"210\" cy=\"60\" r=\"2\"/><circle cx=\"330\" cy=\"150\" r=\"2.5\"/>\n    <circle cx=\"840\" cy=\"90\" r=\"2\"/><circle cx=\"930\" cy=\"200\" r=\"3\"/><circle cx=\"160\" cy=\"300\" r=\"2\"/>\n    <circle cx=\"420\" cy=\"80\" r=\"2\"/><circle cx=\"880\" cy=\"330\" r=\"2\"/>\n  </g>\n  <path d=\"M800 130 a55 55 0 1 0 50 75 a44 44 0 1 1 -50 -75z\" fill=\"none\" stroke=\"#F4A434\" stroke-width=\"5\" stroke-linejoin=\"round\"/>\n\n  \n  <g fill=\"none\" stroke=\"#F4A434\" stroke-width=\"5\" stroke-linejoin=\"round\" stroke-linecap=\"round\">\n    <path d=\"M170 520 L170 360 L200 330 L200 280 L230 230 L260 280 L260 330 L290 360 L290 520\"/>\n    <circle cx=\"230\" cy=\"400\" r=\"26\"/>\n    <path d=\"M230 384 L230 400 L244 408\"/>\n    <path d=\"M50 1000 L50 610 L120 560 L340 560 L410 610 L410 1000\"/>\n    <path d=\"M120 560 L120 520 L340 520 L340 560\"/>\n  </g>\n  <g fill=\"url(\"#win\")\" opacity=\".9\">\n    <path d=\"M85 700 a22 22 0 0 1 44 0 v70 h-44z\"/><path d=\"M160 700 a22 22 0 0 1 44 0 v70 h-44z\"/>\n    <path d=\"M256 700 a22 22 0 0 1 44 0 v70 h-44z\"/><path d=\"M331 700 a22 22 0 0 1 44 0 v70 h-44z\"/>\n    <path d=\"M85 830 a22 22 0 0 1 44 0 v70 h-44z\"/><path d=\"M331 830 a22 22 0 0 1 44 0 v70 h-44z\"/>\n  </g>\n  <path d=\"M195 1000 L195 860 a35 35 0 0 1 70 0 L265 1000\" fill=\"none\" stroke=\"#F4A434\" stroke-width=\"5\"/>\n\n  \n  <circle cx=\"660\" cy=\"380\" r=\"230\" fill=\"url(\"#glow\")\"/>\n\n  \n  <path d=\"M652 1000 L660 120 L668 1000 Z\" fill=\"#F4F1EC\" opacity=\".92\"/>\n  <ellipse cx=\"660\" cy=\"150\" rx=\"3.5\" ry=\"14\" fill=\"#110C08\"/>\n  <path d=\"M652 1000 L660 120 L668 1000\" fill=\"none\" stroke=\"#F4A434\" stroke-width=\"3\"/>\n\n  \n  <g transform=\"translate(660 390) rotate(-18)\">\n    <g stroke=\"#F4A434\" stroke-width=\"7\" stroke-linecap=\"round\" fill=\"none\">\n      <path d=\"M-70 -40 L-130 -80 L-150 -60\"/><path d=\"M-80 10 L-150 10 L-170 40\"/><path d=\"M-70 55 L-120 100 L-110 130\"/>\n      <path d=\"M70 -40 L130 -80 L150 -60\"/><path d=\"M80 10 L150 10 L170 40\"/><path d=\"M70 55 L120 100 L110 130\"/>\n      <path d=\"M-20 -150 Q-40 -200 -80 -215\"/><path d=\"M20 -150 Q40 -200 80 -215\"/>\n    </g>\n    <ellipse cx=\"0\" cy=\"-118\" rx=\"40\" ry=\"34\" fill=\"#0B4D38\" stroke=\"#F4A434\" stroke-width=\"6\"/>\n    <ellipse cx=\"0\" cy=\"20\" rx=\"88\" ry=\"125\" fill=\"url(\"#shell\")\" stroke=\"#F4A434\" stroke-width=\"7\"/>\n    <path d=\"M0 -100 L0 140\" stroke=\"#0B4D38\" stroke-width=\"5\"/>\n    <ellipse cx=\"-34\" cy=\"-30\" rx=\"18\" ry=\"46\" fill=\"#F4F1EC\" opacity=\".35\"/>\n  </g>\n  \n  <path d=\"M660 250 L660 540\" stroke=\"#F4F1EC\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n  <path d=\"M660 250 L660 540\" stroke=\"#110C08\" stroke-width=\"1.5\" opacity=\".35\"/>\n\n  \n  <path d=\"M0 1000 L1000 1000\" stroke=\"#F4A434\" stroke-width=\"5\"/>\n  <g stroke=\"#F4A434\" stroke-width=\"4\" stroke-linecap=\"round\" opacity=\".55\">\n    <path d=\"M560 1040 L620 1040\"/><path d=\"M700 1040 L800 1040\"/><path d=\"M460 1075 L520 1075\"/><path d=\"M860 1075 L940 1075\"/>\n  </g>\n</svg>\n\n  <div class=\"grain\"></div>\n  <div style=\"position:absolute; left:var(--pad); top:80px\">\n    <div class=\"kicker\" data-slot=\"kicker\" data-label=\"Kicker\" data-max=\"30\">Next crawl · Leuven</div>\n    <h1 class=\"display d-xl\" style=\"margin-top:18px\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"20\">Meet<br><span class=\"gold\">the bug.</span></h1>\n  </div>\n  <div class=\"info\">\n    <span class=\"display d-m\" data-slot=\"datum\" data-label=\"Datum\" data-max=\"20\">Sat 24 Oct</span>\n    <span class=\"lead\" data-slot=\"uur\" data-label=\"Uur en plek\" data-max=\"40\">21:00 · Ladeuzeplein</span>\n    <span class=\"pill amber\" style=\"align-self:flex-start\" data-slot=\"prijs\" data-label=\"Prijs\" data-max=\"30\">€19 early bird</span>\n  </div>\n</body>\n</html>\n"}