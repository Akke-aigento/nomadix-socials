{"version":1,"width":1080,"height":1920,"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"nx-size\" content=\"1080x1920\">\n<title>Leuven Lore — Margriet</title>\n<style>/* The Fonske Crawl — huisstijl voor Instagram (posts 1080x1350, stories/reels 1080x1920).\n   Afgeleid van fonskecrawl.com (repo fonske-crawl-hq, src/styles.css): warm bijna-zwart, amber/goud, crème.\n   Fonts: Bebas Neue (titels) en Space Grotesk (tekst), beide OFL, lokaal in ./fonts. */\n\n@font-face { font-family: \"Bebas Neue\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/bebas-neue-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n\n:root {\n  --ink: #110C08;        /* achtergrond (site --background) */\n  --card: #1D1711;       /* vlakken */\n  --line: rgba(244,241,236,.14);\n  --amber: #F4A434;      /* primair (site --primary) */\n  --gold-a: #F6CB6A;     /* goudverloop begin */\n  --gold-b: #E58A2A;     /* goudverloop eind */\n  --red: #D45A4F;        /* accent, spaarzaam (site --accent): deadlines */\n  --cream: #F4F1EC;      /* tekst */\n  --mute: #B7A894;\n  --pad: 80px;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { width: 100%; height: 100%; }\nbody {\n  background:\n    radial-gradient(110% 70% at 50% 0%, rgba(150,95,30,.38) 0%, transparent 62%),\n    radial-gradient(70% 50% at 100% 100%, rgba(120,70,20,.22) 0%, transparent 70%),\n    linear-gradient(180deg, #17110B 0%, var(--ink) 100%);\n  color: var(--cream);\n  font-family: \"Space Grotesk\", sans-serif; -webkit-font-smoothing: antialiased;\n  overflow: hidden; position: relative;\n}\n.grain { position: absolute; inset: 0; opacity: .14; mix-blend-mode: overlay; pointer-events: none;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/%2523n\")'/></svg>\"); }\n\n/* Typografie */\n.display { font-family: \"Bebas Neue\", sans-serif; font-weight: 400; line-height: .88; letter-spacing: .01em; text-transform: uppercase; }\n.d-xxl { font-size: 260px; }\n.d-xl { font-size: 190px; }\n.d-l  { font-size: 140px; }\n.d-m  { font-size: 96px; }\n.d-s  { font-size: 60px; }\n.gold { background: linear-gradient(100deg, var(--gold-a) 0%, var(--gold-b) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }\n.amber { color: var(--amber); }\n.red { color: var(--red); }\n.lead { font-size: 38px; line-height: 1.32; font-weight: 500; color: rgba(244,241,236,.92); }\n.body { font-size: 30px; line-height: 1.45; color: rgba(244,241,236,.82); }\n.kicker { font-size: 24px; font-weight: 700; letter-spacing: .26em; text-transform: uppercase; color: var(--amber); }\n.small { font-size: 24px; letter-spacing: .08em; color: var(--mute); }\n\n/* Logo */\n.mark { position: absolute; height: auto; }\n.wordmark { font-family: \"Bebas Neue\", sans-serif; font-size: 40px; letter-spacing: .06em; color: var(--cream); }\n.brandrow { position: absolute; display: flex; align-items: center; gap: 18px; }\n.brandrow img { width: 58px; height: auto; }\n\n/* Info-rijen (wanneer / waar / prijs) */\n.rows { display: grid; }\n.row { display: flex; align-items: baseline; gap: 28px; padding: 24px 0; border-top: 2px solid var(--line); }\n.row:last-child { border-bottom: 2px solid var(--line); }\n.row .k { min-width: 190px; font-size: 24px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--mute); }\n.row .v { font-family: \"Bebas Neue\", sans-serif; font-size: 64px; line-height: 1; color: var(--cream); }\n\n/* Genummerde stappen */\n.step { display: flex; gap: 34px; align-items: flex-start; }\n.step .n { font-family: \"Bebas Neue\", sans-serif; font-size: 150px; line-height: .78; color: transparent; -webkit-text-stroke: 2px var(--amber); min-width: 110px; }\n.step .t { font-family: \"Bebas Neue\", sans-serif; font-size: 66px; line-height: .95; text-transform: uppercase; }\n.step .s { font-size: 28px; line-height: 1.4; color: rgba(244,241,236,.78); margin-top: 10px; }\n\n/* Prijs, pil en ticket-stub */\n.pill { display: inline-flex; align-items: center; gap: 14px; padding: 20px 32px; border-radius: 999px; font-size: 28px; font-weight: 700; }\n.pill.amber { background: var(--amber); color: var(--ink); }\n.pill.ghost { border: 2px solid var(--line); color: var(--cream); }\n.stub { display: flex; align-items: stretch; border: 2px dashed rgba(244,164,52,.55); border-radius: 28px; overflow: hidden; }\n.stub .p { padding: 26px 36px; font-family: \"Bebas Neue\", sans-serif; font-size: 120px; line-height: .9; background: rgba(244,164,52,.1); }\n.stub .i { padding: 28px 34px; display: flex; flex-direction: column; justify-content: center; gap: 8px; border-left: 2px dashed rgba(244,164,52,.55); }\n.strike-none { text-decoration: none; }\n\n/* Stories met een link-sticker: laat rond y 1300–1560 een vrije strook (geen tekst), daar komt de sticker. */\n\n/* Veilige zones voor stories/reels: boven 250 px en onder 340 px vrij van tekst */\n.story-safe { position: absolute; top: 250px; bottom: 340px; left: var(--pad); right: var(--pad); }\n</style>\n<!-- Story met link-sticker. Feiten: Margaret of Louvain, †1225 aan de Dijle. Illustratie: illustrations/dijle.svg -->\n<style>\nbody.v-navy { background: #0E1626; }\n\n</style>\n</head>\n<body class=\"v-navy\">\n  <div class=\"grain\"></div>\n  <div class=\"brandrow\" style=\"top:250px; left:var(--pad)\"><img src=\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/logo-mark.png\" alt=\"\"><span class=\"wordmark\">The Fonske Crawl</span></div>\n  <div style=\"position:absolute; left:var(--pad); right:var(--pad); top:380px; display:flex; flex-direction:column; gap:36px\">\n    <div class=\"kicker\" data-slot=\"reeks\" data-label=\"Reeks\" data-max=\"26\">Leuven Lore · 01</div>\n    <h1 class=\"display d-l\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"60\">Our first bar is named after a <span class=\"gold\">murder victim.</span></h1>\n    <p class=\"lead\" data-slot=\"tekst\" data-label=\"Tekst\" data-max=\"190\" data-multiline=\"true\">Leuven, 1225. Margriet, a young servant at an inn, was killed by robbers by the Dijle. The city still calls her Fiere Margriet.</p>\n  </div>\n  <svg style=\"position:absolute; left:0; bottom:0; width:1080px; height:972px\" preserveAspectRatio=\"xMidYMax meet\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1000 900\">\n  \n  <g fill=\"#F4F1EC\" opacity=\".6\"><circle cx=\"120\" cy=\"90\" r=\"3\"/><circle cx=\"260\" cy=\"40\" r=\"2\"/><circle cx=\"880\" cy=\"70\" r=\"2.5\"/><circle cx=\"700\" cy=\"140\" r=\"2\"/></g>\n  <circle cx=\"740\" cy=\"200\" r=\"70\" fill=\"none\" stroke=\"#F4F1EC\" stroke-width=\"5\"/>\n  <circle cx=\"740\" cy=\"200\" r=\"110\" fill=\"#F4F1EC\" opacity=\".05\"/>\n  \n  <g fill=\"#0E1626\" stroke=\"#F4A434\" stroke-width=\"5\" stroke-linejoin=\"round\">\n    <path d=\"M0 520 L0 360 L60 300 L120 360 L120 520 Z\"/>\n    <path d=\"M120 520 L120 330 L180 270 L240 330 L240 520 Z\"/>\n    <path d=\"M240 520 L240 380 L290 330 L340 380 L340 520 Z\"/>\n  </g>\n  <g fill=\"#F4A434\"><rect x=\"40\" y=\"400\" width=\"34\" height=\"44\" rx=\"3\"/><rect x=\"160\" y=\"370\" width=\"34\" height=\"44\" rx=\"3\"/></g>\n  \n  <g stroke=\"#F4A434\" stroke-width=\"5\" fill=\"none\" stroke-linecap=\"round\">\n    <path d=\"M340 400 L470 400\"/><path d=\"M390 400 L390 430\"/><path d=\"M450 400 L450 430\"/>\n  </g>\n  <rect x=\"370\" y=\"430\" width=\"100\" height=\"80\" rx=\"10\" fill=\"#1D1711\" stroke=\"#F4A434\" stroke-width=\"5\"/>\n  <path d=\"M392 488 L398 452 L410 470 L420 448 L430 470 L442 452 L448 488 Z\" fill=\"#F6CB6A\"/>\n  \n  <path d=\"M0 540 L1000 540\" stroke=\"#F4A434\" stroke-width=\"5\"/>\n  <g stroke=\"#F4F1EC\" stroke-width=\"4\" stroke-linecap=\"round\" fill=\"none\" opacity=\".55\">\n    <path d=\"M60 600 q30 -16 60 0 t60 0\"/><path d=\"M300 640 q30 -16 60 0 t60 0 t60 0\"/><path d=\"M620 600 q30 -16 60 0 t60 0\"/>\n    <path d=\"M140 720 q30 -16 60 0 t60 0 t60 0\"/><path d=\"M520 760 q30 -16 60 0 t60 0\"/><path d=\"M780 700 q30 -16 60 0 t60 0\"/>\n    <path d=\"M260 830 q30 -16 60 0 t60 0\"/><path d=\"M640 850 q30 -16 60 0 t60 0\"/>\n  </g>\n  \n  <g stroke=\"#F4F1EC\" stroke-width=\"5\" stroke-linecap=\"round\" opacity=\".8\">\n    <path d=\"M700 610 L780 610\"/><path d=\"M712 640 L768 640\"/><path d=\"M724 670 L756 670\"/>\n  </g>\n  \n  <g stroke=\"#F4A434\" stroke-width=\"4\" stroke-linecap=\"round\" fill=\"none\">\n    <path d=\"M900 540 Q905 470 930 430\"/><path d=\"M920 540 Q925 480 960 450\"/><path d=\"M880 540 Q875 490 860 455\"/>\n  </g>\n</svg>\n\n</body>\n</html>\n"}