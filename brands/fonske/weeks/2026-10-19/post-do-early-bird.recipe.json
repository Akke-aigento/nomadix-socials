{"version":1,"width":1080,"height":1350,"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"nx-size\" content=\"1080x1350\">\n<title>Early bird ends tomorrow</title>\n<style>/* The Fonske Crawl — huisstijl voor Instagram (posts 1080x1350, stories/reels 1080x1920).\n   Afgeleid van fonskecrawl.com (repo fonske-crawl-hq, src/styles.css): warm bijna-zwart, amber/goud, crème.\n   Fonts: Bebas Neue (titels) en Space Grotesk (tekst), beide OFL, lokaal in ./fonts. */\n\n@font-face { font-family: \"Bebas Neue\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/bebas-neue-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n\n:root {\n  --ink: #110C08;        /* achtergrond (site --background) */\n  --card: #1D1711;       /* vlakken */\n  --line: rgba(244,241,236,.14);\n  --amber: #F4A434;      /* primair (site --primary) */\n  --gold-a: #F6CB6A;     /* goudverloop begin */\n  --gold-b: #E58A2A;     /* goudverloop eind */\n  --red: #D45A4F;        /* accent, spaarzaam (site --accent): deadlines */\n  --cream: #F4F1EC;      /* tekst */\n  --mute: #B7A894;\n  --pad: 80px;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { width: 100%; height: 100%; }\nbody {\n  background:\n    radial-gradient(110% 70% at 50% 0%, rgba(150,95,30,.38) 0%, transparent 62%),\n    radial-gradient(70% 50% at 100% 100%, rgba(120,70,20,.22) 0%, transparent 70%),\n    linear-gradient(180deg, #17110B 0%, var(--ink) 100%);\n  color: var(--cream);\n  font-family: \"Space Grotesk\", sans-serif; -webkit-font-smoothing: antialiased;\n  overflow: hidden; position: relative;\n}\n.grain { position: absolute; inset: 0; opacity: .14; mix-blend-mode: overlay; pointer-events: none;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/%2523n\")'/></svg>\"); }\n\n/* Typografie */\n.display { font-family: \"Bebas Neue\", sans-serif; font-weight: 400; line-height: .88; letter-spacing: .01em; text-transform: uppercase; }\n.d-xxl { font-size: 260px; }\n.d-xl { font-size: 190px; }\n.d-l  { font-size: 140px; }\n.d-m  { font-size: 96px; }\n.d-s  { font-size: 60px; }\n.gold { background: linear-gradient(100deg, var(--gold-a) 0%, var(--gold-b) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }\n.amber { color: var(--amber); }\n.red { color: var(--red); }\n.lead { font-size: 38px; line-height: 1.32; font-weight: 500; color: rgba(244,241,236,.92); }\n.body { font-size: 30px; line-height: 1.45; color: rgba(244,241,236,.82); }\n.kicker { font-size: 24px; font-weight: 700; letter-spacing: .26em; text-transform: uppercase; color: var(--amber); }\n.small { font-size: 24px; letter-spacing: .08em; color: var(--mute); }\n\n/* Logo */\n.mark { position: absolute; height: auto; }\n.wordmark { font-family: \"Bebas Neue\", sans-serif; font-size: 40px; letter-spacing: .06em; color: var(--cream); }\n.brandrow { position: absolute; display: flex; align-items: center; gap: 18px; }\n.brandrow img { width: 58px; height: auto; }\n\n/* Info-rijen (wanneer / waar / prijs) */\n.rows { display: grid; }\n.row { display: flex; align-items: baseline; gap: 28px; padding: 24px 0; border-top: 2px solid var(--line); }\n.row:last-child { border-bottom: 2px solid var(--line); }\n.row .k { min-width: 190px; font-size: 24px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--mute); }\n.row .v { font-family: \"Bebas Neue\", sans-serif; font-size: 64px; line-height: 1; color: var(--cream); }\n\n/* Genummerde stappen */\n.step { display: flex; gap: 34px; align-items: flex-start; }\n.step .n { font-family: \"Bebas Neue\", sans-serif; font-size: 150px; line-height: .78; color: transparent; -webkit-text-stroke: 2px var(--amber); min-width: 110px; }\n.step .t { font-family: \"Bebas Neue\", sans-serif; font-size: 66px; line-height: .95; text-transform: uppercase; }\n.step .s { font-size: 28px; line-height: 1.4; color: rgba(244,241,236,.78); margin-top: 10px; }\n\n/* Prijs, pil en ticket-stub */\n.pill { display: inline-flex; align-items: center; gap: 14px; padding: 20px 32px; border-radius: 999px; font-size: 28px; font-weight: 700; }\n.pill.amber { background: var(--amber); color: var(--ink); }\n.pill.ghost { border: 2px solid var(--line); color: var(--cream); }\n.stub { display: flex; align-items: stretch; border: 2px dashed rgba(244,164,52,.55); border-radius: 28px; overflow: hidden; }\n.stub .p { padding: 26px 36px; font-family: \"Bebas Neue\", sans-serif; font-size: 120px; line-height: .9; background: rgba(244,164,52,.1); }\n.stub .i { padding: 28px 34px; display: flex; flex-direction: column; justify-content: center; gap: 8px; border-left: 2px dashed rgba(244,164,52,.55); }\n.strike-none { text-decoration: none; }\n\n/* Stories met een link-sticker: laat rond y 1300–1560 een vrije strook (geen tekst), daar komt de sticker. */\n\n/* Veilige zones voor stories/reels: boven 250 px en onder 340 px vrij van tekst */\n.story-safe { position: absolute; top: 250px; bottom: 340px; left: var(--pad); right: var(--pad); }\n</style>\n<!-- Prijzen SellQo: €19 tot 23-10 22:00, daarna €25. Geen doorstreepte prijs. Illustratie: early-bird.svg -->\n<style>\nbody.v-x { background: #F4A434; }\n.v-x .display, .v-x .lead, .v-x .body {color:#110C08} .v-x .kicker {color:#110C08; opacity:.7}\n</style>\n</head>\n<body class=\"v-x\">\n  <div class=\"grain\"></div>\n  <div style=\"position:absolute; left:var(--pad); right:var(--pad); top:80px\">\n    <div class=\"kicker\" data-slot=\"kicker\" data-label=\"Kicker\" data-max=\"30\">Fri 23 Oct · 22:00</div>\n    <h1 class=\"display d-l\" style=\"margin-top:18px\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"34\">The early bird<br>gets the €19 ticket.</h1>\n    <p class=\"lead\" style=\"margin-top:24px\" data-slot=\"tekst\" data-label=\"Tekst\" data-max=\"60\">Until tomorrow 22:00. Then it's €25.</p>\n  </div>\n  <svg style=\"position:absolute; left:20px; bottom:150px; width:1040px; height:832px\" preserveAspectRatio=\"xMidYMax meet\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1000 800\">\n  \n  <g fill=\"none\" stroke=\"#110C08\" stroke-width=\"10\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    \n    <path d=\"M40 700 C300 660 600 690 960 640\"/>\n    <path d=\"M700 676 C740 640 780 630 820 640\"/><path d=\"M780 650 q20 -40 60 -50\"/>\n    \n    <path d=\"M300 640 C220 600 210 470 300 420 C360 385 450 400 480 450 C520 520 500 600 430 640 Z\" fill=\"#F4F1EC\"/>\n    \n    <path d=\"M300 520 C330 480 400 480 420 540 C390 580 330 590 300 520 Z\" fill=\"#F6CB6A\"/>\n    \n    <path d=\"M240 600 L150 640 L230 650\"/>\n    \n    <path d=\"M360 640 L350 690\"/><path d=\"M410 640 L415 690\"/>\n    \n    <path d=\"M478 440 L540 420 L485 470\" fill=\"#E58A2A\"/>\n  </g>\n  \n  <circle cx=\"430\" cy=\"440\" r=\"11\" fill=\"#110C08\"/>\n  \n  <g transform=\"translate(560 370) rotate(-14)\">\n    <path d=\"M0 0 H300 V40 a22 22 0 0 0 0 44 V124 H0 V84 a22 22 0 0 0 0 -44 Z\" fill=\"#F4F1EC\" stroke=\"#110C08\" stroke-width=\"8\" stroke-linejoin=\"round\"/>\n    <path d=\"M80 10 V114\" stroke=\"#110C08\" stroke-width=\"4\" stroke-dasharray=\"10 10\"/>\n    <text x=\"190\" y=\"88\" text-anchor=\"middle\" font-family=\"Bebas Neue, sans-serif\" font-size=\"78\" fill=\"#110C08\">€19</text>\n    <text x=\"40\" y=\"70\" text-anchor=\"middle\" font-family=\"Bebas Neue, sans-serif\" font-size=\"26\" fill=\"#110C08\" transform=\"rotate(-90 40 62)\">ADMIT ONE</text>\n  </g>\n  \n  <g stroke=\"#110C08\" stroke-width=\"6\" stroke-linecap=\"round\" opacity=\".5\">\n    <path d=\"M880 330 L940 310\"/><path d=\"M890 380 L960 380\"/><path d=\"M880 430 L940 450\"/>\n  </g>\n</svg>\n\n  <div style=\"position:absolute; left:var(--pad); right:var(--pad); bottom:70px; display:flex; align-items:center; justify-content:space-between\">\n    <span class=\"pill\" style=\"background:#110C08; color:#F4F1EC\" data-slot=\"cta\" data-label=\"Knop\" data-max=\"30\">Tickets · link in bio</span>\n    <span class=\"body\" style=\"color:#110C08\" data-slot=\"datum\" data-label=\"Datum\" data-max=\"30\">Crawl: Sat 24 Oct</span>\n  </div>\n</body>\n</html>\n"}