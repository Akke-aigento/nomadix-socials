{"version":1,"width":1080,"height":1920,"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"nx-size\" content=\"1080x1920\">\n<title>The finale</title>\n<style>/* The Fonske Crawl — huisstijl voor Instagram (posts 1080x1350, stories/reels 1080x1920).\n   Afgeleid van fonskecrawl.com (repo fonske-crawl-hq, src/styles.css): warm bijna-zwart, amber/goud, crème.\n   Fonts: Bebas Neue (titels) en Space Grotesk (tekst), beide OFL, lokaal in ./fonts. */\n\n@font-face { font-family: \"Bebas Neue\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/bebas-neue-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n\n:root {\n  --ink: #110C08;        /* achtergrond (site --background) */\n  --card: #1D1711;       /* vlakken */\n  --line: rgba(244,241,236,.14);\n  --amber: #F4A434;      /* primair (site --primary) */\n  --gold-a: #F6CB6A;     /* goudverloop begin */\n  --gold-b: #E58A2A;     /* goudverloop eind */\n  --red: #D45A4F;        /* accent, spaarzaam (site --accent): deadlines */\n  --cream: #F4F1EC;      /* tekst */\n  --mute: #B7A894;\n  --pad: 80px;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { width: 100%; height: 100%; }\nbody {\n  background:\n    radial-gradient(110% 70% at 50% 0%, rgba(150,95,30,.38) 0%, transparent 62%),\n    radial-gradient(70% 50% at 100% 100%, rgba(120,70,20,.22) 0%, transparent 70%),\n    linear-gradient(180deg, #17110B 0%, var(--ink) 100%);\n  color: var(--cream);\n  font-family: \"Space Grotesk\", sans-serif; -webkit-font-smoothing: antialiased;\n  overflow: hidden; position: relative;\n}\n.grain { position: absolute; inset: 0; opacity: .14; mix-blend-mode: overlay; pointer-events: none;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>\"); }\n\n/* Typografie */\n.display { font-family: \"Bebas Neue\", sans-serif; font-weight: 400; line-height: .88; letter-spacing: .01em; text-transform: uppercase; }\n.d-xxl { font-size: 260px; }\n.d-xl { font-size: 190px; }\n.d-l  { font-size: 140px; }\n.d-m  { font-size: 96px; }\n.d-s  { font-size: 60px; }\n.gold { background: linear-gradient(100deg, var(--gold-a) 0%, var(--gold-b) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }\n.amber { color: var(--amber); }\n.red { color: var(--red); }\n.lead { font-size: 38px; line-height: 1.32; font-weight: 500; color: rgba(244,241,236,.92); }\n.body { font-size: 30px; line-height: 1.45; color: rgba(244,241,236,.82); }\n.kicker { font-size: 24px; font-weight: 700; letter-spacing: .26em; text-transform: uppercase; color: var(--amber); }\n.small { font-size: 24px; letter-spacing: .08em; color: var(--mute); }\n\n/* Logo */\n.mark { position: absolute; height: auto; }\n.wordmark { font-family: \"Bebas Neue\", sans-serif; font-size: 40px; letter-spacing: .06em; color: var(--cream); }\n.brandrow { position: absolute; display: flex; align-items: center; gap: 18px; }\n.brandrow img { width: 58px; height: auto; }\n\n/* Info-rijen (wanneer / waar / prijs) */\n.rows { display: grid; }\n.row { display: flex; align-items: baseline; gap: 28px; padding: 24px 0; border-top: 2px solid var(--line); }\n.row:last-child { border-bottom: 2px solid var(--line); }\n.row .k { min-width: 190px; font-size: 24px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--mute); }\n.row .v { font-family: \"Bebas Neue\", sans-serif; font-size: 64px; line-height: 1; color: var(--cream); }\n\n/* Genummerde stappen */\n.step { display: flex; gap: 34px; align-items: flex-start; }\n.step .n { font-family: \"Bebas Neue\", sans-serif; font-size: 150px; line-height: .78; color: transparent; -webkit-text-stroke: 2px var(--amber); min-width: 110px; }\n.step .t { font-family: \"Bebas Neue\", sans-serif; font-size: 66px; line-height: .95; text-transform: uppercase; }\n.step .s { font-size: 28px; line-height: 1.4; color: rgba(244,241,236,.78); margin-top: 10px; }\n\n/* Prijs, pil en ticket-stub */\n.pill { display: inline-flex; align-items: center; gap: 14px; padding: 20px 32px; border-radius: 999px; font-size: 28px; font-weight: 700; }\n.pill.amber { background: var(--amber); color: var(--ink); }\n.pill.ghost { border: 2px solid var(--line); color: var(--cream); }\n.stub { display: flex; align-items: stretch; border: 2px dashed rgba(244,164,52,.55); border-radius: 28px; overflow: hidden; }\n.stub .p { padding: 26px 36px; font-family: \"Bebas Neue\", sans-serif; font-size: 120px; line-height: .9; background: rgba(244,164,52,.1); }\n.stub .i { padding: 28px 34px; display: flex; flex-direction: column; justify-content: center; gap: 8px; border-left: 2px dashed rgba(244,164,52,.55); }\n.strike-none { text-decoration: none; }\n\n/* Stories met een link-sticker: laat rond y 1300–1560 een vrije strook (geen tekst), daar komt de sticker. */\n\n/* Veilige zones voor stories/reels: boven 250 px en onder 340 px vrij van tekst */\n.story-safe { position: absolute; top: 250px; bottom: 340px; left: var(--pad); right: var(--pad); }\n</style>\n<!-- Story met link-sticker. Illustratie: oude-markt.svg -->\n<style>\nbody.v-night2 { background: #110C08; }\n\n</style>\n</head>\n<body class=\"v-night2\">\n  <div class=\"grain\"></div>\n  <div class=\"brandrow\" style=\"top:250px; left:var(--pad)\"><img src=\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/logo-mark.png\" alt=\"\"><span class=\"wordmark\">The Fonske Crawl</span></div>\n  <div style=\"position:absolute; left:var(--pad); right:var(--pad); top:370px\">\n    <h1 class=\"display d-xl\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"30\">One night.<br><span class=\"gold\">Four bars.</span><br>One finale.</h1>\n    <p class=\"lead\" style=\"margin-top:36px\" data-slot=\"tekst\" data-label=\"Tekst\" data-max=\"90\" data-multiline=\"true\">We end on the Oude Markt, the longest bar in Europe.</p>\n  </div>\n  <svg style=\"position:absolute; left:0; bottom:120px; width:1080px; height:756px\" preserveAspectRatio=\"xMidYMax meet\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1000 700\">\n  \n  <defs>\n    <linearGradient id=\"w\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#F6CB6A\"/><stop offset=\"1\" stop-color=\"#E58A2A\"/></linearGradient>\n  </defs>\n  <g fill=\"#1D1711\" stroke=\"#F4A434\" stroke-width=\"5\" stroke-linejoin=\"round\">\n    <path d=\"M10 560 L10 260 L40 260 L40 220 L70 220 L70 180 L110 140 L150 180 L150 220 L180 220 L180 260 L210 260 L210 560 Z\"/>\n    <path d=\"M210 560 L210 200 L250 150 L290 110 L330 150 L370 200 L370 560 Z\"/>\n    <path d=\"M370 560 L370 240 L395 240 L395 205 L420 205 L420 170 L450 140 L480 170 L480 205 L505 205 L505 240 L530 240 L530 560 Z\"/>\n    <path d=\"M530 560 L530 180 L620 100 L710 180 L710 560 Z\"/>\n    <path d=\"M710 560 L710 250 L735 250 L735 215 L760 215 L760 180 L800 150 L840 180 L840 215 L865 215 L865 250 L890 250 L890 560 Z\"/>\n    <path d=\"M890 560 L890 220 L945 170 L1000 220 L1000 560\"/>\n  </g>\n  <g fill=\"url(\"#w\")\">\n    <rect x=\"45\" y=\"300\" width=\"40\" height=\"60\" rx=\"4\"/><rect x=\"135\" y=\"300\" width=\"40\" height=\"60\" rx=\"4\"/>\n    <rect x=\"45\" y=\"400\" width=\"40\" height=\"60\" rx=\"4\"/><rect x=\"135\" y=\"400\" width=\"40\" height=\"60\" rx=\"4\"/>\n    <rect x=\"240\" y=\"250\" width=\"40\" height=\"60\" rx=\"4\"/><rect x=\"300\" y=\"250\" width=\"40\" height=\"60\" rx=\"4\"/>\n    <rect x=\"240\" y=\"350\" width=\"40\" height=\"60\" rx=\"4\"/><rect x=\"300\" y=\"350\" width=\"40\" height=\"60\" rx=\"4\"/>\n    <rect x=\"400\" y=\"280\" width=\"40\" height=\"60\" rx=\"4\"/><rect x=\"460\" y=\"280\" width=\"40\" height=\"60\" rx=\"4\"/>\n    <rect x=\"400\" y=\"380\" width=\"40\" height=\"60\" rx=\"4\"/><rect x=\"460\" y=\"380\" width=\"40\" height=\"60\" rx=\"4\"/>\n    <rect x=\"565\" y=\"230\" width=\"40\" height=\"60\" rx=\"4\"/><rect x=\"635\" y=\"230\" width=\"40\" height=\"60\" rx=\"4\"/>\n    <rect x=\"565\" y=\"330\" width=\"40\" height=\"60\" rx=\"4\"/><rect x=\"635\" y=\"330\" width=\"40\" height=\"60\" rx=\"4\"/>\n    <rect x=\"740\" y=\"290\" width=\"40\" height=\"60\" rx=\"4\"/><rect x=\"820\" y=\"290\" width=\"40\" height=\"60\" rx=\"4\"/>\n    <rect x=\"740\" y=\"390\" width=\"40\" height=\"60\" rx=\"4\"/><rect x=\"820\" y=\"390\" width=\"40\" height=\"60\" rx=\"4\"/>\n    <rect x=\"920\" y=\"270\" width=\"40\" height=\"60\" rx=\"4\"/><rect x=\"920\" y=\"370\" width=\"40\" height=\"60\" rx=\"4\"/>\n  </g>\n  \n  <path d=\"M0 470 Q125 520 250 470 T500 470 T750 470 T1000 470\" fill=\"none\" stroke=\"#F4F1EC\" stroke-width=\"3\" opacity=\".7\"/>\n  <g fill=\"#F6CB6A\">\n    <circle cx=\"60\" cy=\"488\" r=\"8\"/><circle cx=\"125\" cy=\"495\" r=\"8\"/><circle cx=\"190\" cy=\"488\" r=\"8\"/>\n    <circle cx=\"310\" cy=\"488\" r=\"8\"/><circle cx=\"375\" cy=\"495\" r=\"8\"/><circle cx=\"440\" cy=\"488\" r=\"8\"/>\n    <circle cx=\"560\" cy=\"488\" r=\"8\"/><circle cx=\"625\" cy=\"495\" r=\"8\"/><circle cx=\"690\" cy=\"488\" r=\"8\"/>\n    <circle cx=\"810\" cy=\"488\" r=\"8\"/><circle cx=\"875\" cy=\"495\" r=\"8\"/><circle cx=\"940\" cy=\"488\" r=\"8\"/>\n  </g>\n  \n  <path d=\"M0 560 L1000 560\" stroke=\"#F4A434\" stroke-width=\"5\"/>\n  <g stroke=\"#F4A434\" stroke-width=\"5\" stroke-linecap=\"round\" fill=\"none\">\n    <path d=\"M80 620 L200 620 M140 620 L140 690\"/><path d=\"M380 620 L500 620 M440 620 L440 690\"/><path d=\"M700 620 L820 620 M760 620 L760 690\"/>\n  </g>\n  <g fill=\"url(\"#w\")\" stroke=\"#F4F1EC\" stroke-width=\"3\">\n    <path d=\"M105 580 h22 l-3 40 h-16z\"/><path d=\"M160 584 h22 l-3 36 h-16z\"/>\n    <path d=\"M405 580 h22 l-3 40 h-16z\"/><path d=\"M455 584 h22 l-3 36 h-16z\"/>\n    <path d=\"M725 580 h22 l-3 40 h-16z\"/><path d=\"M780 584 h22 l-3 36 h-16z\"/>\n  </g>\n  <g fill=\"#F4F1EC\"><rect x=\"105\" y=\"574\" width=\"22\" height=\"8\" rx=\"4\"/><rect x=\"405\" y=\"574\" width=\"22\" height=\"8\" rx=\"4\"/><rect x=\"725\" y=\"574\" width=\"22\" height=\"8\" rx=\"4\"/></g>\n</svg>\n\n</body>\n</html>\n"}