{"version":1,"width":1080,"height":1350,"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"nx-size\" content=\"1080x1350\">\n<title>How the night goes</title>\n<style>/* The Fonske Crawl — huisstijl voor Instagram (posts 1080x1350, stories/reels 1080x1920).\n   Afgeleid van fonskecrawl.com (repo fonske-crawl-hq, src/styles.css): warm bijna-zwart, amber/goud, crème.\n   Fonts: Bebas Neue (titels) en Space Grotesk (tekst), beide OFL, lokaal in ./fonts. */\n\n@font-face { font-family: \"Bebas Neue\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/bebas-neue-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n\n:root {\n  --ink: #110C08;        /* achtergrond (site --background) */\n  --card: #1D1711;       /* vlakken */\n  --line: rgba(244,241,236,.14);\n  --amber: #F4A434;      /* primair (site --primary) */\n  --gold-a: #F6CB6A;     /* goudverloop begin */\n  --gold-b: #E58A2A;     /* goudverloop eind */\n  --red: #D45A4F;        /* accent, spaarzaam (site --accent): deadlines */\n  --cream: #F4F1EC;      /* tekst */\n  --mute: #B7A894;\n  --pad: 80px;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { width: 100%; height: 100%; }\nbody {\n  background:\n    radial-gradient(110% 70% at 50% 0%, rgba(150,95,30,.38) 0%, transparent 62%),\n    radial-gradient(70% 50% at 100% 100%, rgba(120,70,20,.22) 0%, transparent 70%),\n    linear-gradient(180deg, #17110B 0%, var(--ink) 100%);\n  color: var(--cream);\n  font-family: \"Space Grotesk\", sans-serif; -webkit-font-smoothing: antialiased;\n  overflow: hidden; position: relative;\n}\n.grain { position: absolute; inset: 0; opacity: .14; mix-blend-mode: overlay; pointer-events: none;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/%2523n\")'/></svg>\"); }\n\n/* Typografie */\n.display { font-family: \"Bebas Neue\", sans-serif; font-weight: 400; line-height: .88; letter-spacing: .01em; text-transform: uppercase; }\n.d-xxl { font-size: 260px; }\n.d-xl { font-size: 190px; }\n.d-l  { font-size: 140px; }\n.d-m  { font-size: 96px; }\n.d-s  { font-size: 60px; }\n.gold { background: linear-gradient(100deg, var(--gold-a) 0%, var(--gold-b) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }\n.amber { color: var(--amber); }\n.red { color: var(--red); }\n.lead { font-size: 38px; line-height: 1.32; font-weight: 500; color: rgba(244,241,236,.92); }\n.body { font-size: 30px; line-height: 1.45; color: rgba(244,241,236,.82); }\n.kicker { font-size: 24px; font-weight: 700; letter-spacing: .26em; text-transform: uppercase; color: var(--amber); }\n.small { font-size: 24px; letter-spacing: .08em; color: var(--mute); }\n\n/* Logo */\n.mark { position: absolute; height: auto; }\n.wordmark { font-family: \"Bebas Neue\", sans-serif; font-size: 40px; letter-spacing: .06em; color: var(--cream); }\n.brandrow { position: absolute; display: flex; align-items: center; gap: 18px; }\n.brandrow img { width: 58px; height: auto; }\n\n/* Info-rijen (wanneer / waar / prijs) */\n.rows { display: grid; }\n.row { display: flex; align-items: baseline; gap: 28px; padding: 24px 0; border-top: 2px solid var(--line); }\n.row:last-child { border-bottom: 2px solid var(--line); }\n.row .k { min-width: 190px; font-size: 24px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--mute); }\n.row .v { font-family: \"Bebas Neue\", sans-serif; font-size: 64px; line-height: 1; color: var(--cream); }\n\n/* Genummerde stappen */\n.step { display: flex; gap: 34px; align-items: flex-start; }\n.step .n { font-family: \"Bebas Neue\", sans-serif; font-size: 150px; line-height: .78; color: transparent; -webkit-text-stroke: 2px var(--amber); min-width: 110px; }\n.step .t { font-family: \"Bebas Neue\", sans-serif; font-size: 66px; line-height: .95; text-transform: uppercase; }\n.step .s { font-size: 28px; line-height: 1.4; color: rgba(244,241,236,.78); margin-top: 10px; }\n\n/* Prijs, pil en ticket-stub */\n.pill { display: inline-flex; align-items: center; gap: 14px; padding: 20px 32px; border-radius: 999px; font-size: 28px; font-weight: 700; }\n.pill.amber { background: var(--amber); color: var(--ink); }\n.pill.ghost { border: 2px solid var(--line); color: var(--cream); }\n.stub { display: flex; align-items: stretch; border: 2px dashed rgba(244,164,52,.55); border-radius: 28px; overflow: hidden; }\n.stub .p { padding: 26px 36px; font-family: \"Bebas Neue\", sans-serif; font-size: 120px; line-height: .9; background: rgba(244,164,52,.1); }\n.stub .i { padding: 28px 34px; display: flex; flex-direction: column; justify-content: center; gap: 8px; border-left: 2px dashed rgba(244,164,52,.55); }\n.strike-none { text-decoration: none; }\n\n/* Stories met een link-sticker: laat rond y 1300–1560 een vrije strook (geen tekst), daar komt de sticker. */\n\n/* Veilige zones voor stories/reels: boven 250 px en onder 340 px vrij van tekst */\n.story-safe { position: absolute; top: 250px; bottom: 340px; left: var(--pad); right: var(--pad); }\n</style>\n<!-- Feiten site: Totem 21:00, 4 cafés ±45 min, shot per stop (alcoholvrij kan), finale Oude Markt, 18+. Kaart is illustratief. Illustratie: route.svg -->\n<style>\nbody.v-x { background: #F4F1EC; }\n.v-x .display, .v-x .lead, .v-x .body {color:#110C08} .v-x .kicker {color:#110C08; opacity:.7} .legend{display:flex; justify-content:space-between; gap:20px} .legend div{flex:1} .legend b{display:block; font-family:\"Bebas Neue\"; font-size:46px; line-height:1; color:#110C08} .legend span{font-size:24px; line-height:1.35; color:rgba(17,12,8,.75)}\n</style>\n</head>\n<body class=\"v-x\">\n  <div style=\"position:absolute; left:var(--pad); right:var(--pad); top:70px\">\n    <div class=\"kicker\" data-slot=\"kicker\" data-label=\"Kicker\" data-max=\"30\">Sat 24 Oct · 21:00</div>\n    <h1 class=\"display d-l\" style=\"margin-top:14px\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"30\">How the night goes</h1>\n  </div>\n  <svg style=\"position:absolute; left:40px; top:300px; width:1000px; height:800px\" preserveAspectRatio=\"xMidYMax meet\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1000 900\">\n  \n  <g fill=\"none\" stroke=\"#110C08\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    \n    <g stroke-width=\"3\" opacity=\".18\">\n      <path d=\"M0 200 L1000 160\"/><path d=\"M0 470 L1000 520\"/><path d=\"M0 760 L1000 700\"/>\n      <path d=\"M180 0 L240 900\"/><path d=\"M520 0 L470 900\"/><path d=\"M820 0 L860 900\"/>\n    </g>\n    \n    <path d=\"M140 140 C300 120 360 260 300 340 C240 420 380 470 520 430 C680 380 760 300 850 380 C940 460 820 560 700 600 C580 640 520 720 600 790 C660 840 760 820 830 780\" stroke-width=\"7\" stroke-dasharray=\"2 20\" stroke=\"#E58A2A\"/>\n  </g>\n  \n  <g transform=\"translate(140 140)\">\n    <path d=\"M-3 60 L0 -70 L3 60 Z\" fill=\"#110C08\"/>\n    <ellipse cx=\"0\" cy=\"-30\" rx=\"18\" ry=\"26\" fill=\"#1E9E6A\" stroke=\"#110C08\" stroke-width=\"4\"/>\n    <path d=\"M-30 60 L30 60\" stroke=\"#110C08\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n  </g>\n  \n  <g font-family=\"Bebas Neue, sans-serif\" font-size=\"46\" text-anchor=\"middle\" fill=\"#F4F1EC\">\n    <circle cx=\"300\" cy=\"340\" r=\"40\" fill=\"#110C08\"/><text x=\"300\" y=\"356\">1</text>\n    <circle cx=\"520\" cy=\"430\" r=\"40\" fill=\"#110C08\"/><text x=\"520\" y=\"446\">2</text>\n    <circle cx=\"850\" cy=\"380\" r=\"40\" fill=\"#110C08\"/><text x=\"850\" y=\"396\">3</text>\n    <circle cx=\"600\" cy=\"790\" r=\"40\" fill=\"#110C08\" transform=\"translate(-1 -1)\"/><text x=\"599\" y=\"805\">4</text>\n  </g>\n  \n  <g transform=\"translate(860 770)\">\n    <path d=\"M0 -62 L18 -18 L64 -18 L27 10 L41 56 L0 28 L-41 56 L-27 10 L-64 -18 L-18 -18 Z\" fill=\"#F4A434\" stroke=\"#110C08\" stroke-width=\"6\" stroke-linejoin=\"round\"/>\n  </g>\n  \n  <g fill=\"#F6CB6A\" stroke=\"#110C08\" stroke-width=\"3\">\n    <path d=\"M338 290 h22 l-4 30 h-14z\"/><path d=\"M558 380 h22 l-4 30 h-14z\"/><path d=\"M888 330 h22 l-4 30 h-14z\"/><path d=\"M638 740 h22 l-4 30 h-14z\"/>\n  </g>\n</svg>\n\n  <div class=\"legend\" style=\"position:absolute; left:var(--pad); right:var(--pad); bottom:70px\">\n    <div><b data-slot=\"l1\" data-label=\"Start\" data-max=\"16\">Start · 21:00</b><span data-slot=\"l1-uitleg\" data-label=\"Start uitleg\" data-max=\"40\">The Totem, Ladeuzeplein</span></div>\n    <div><b data-slot=\"l2\" data-label=\"Cafés\" data-max=\"16\">4 bars</b><span data-slot=\"l2-uitleg\" data-label=\"Cafés uitleg\" data-max=\"40\">A shot at each, alcohol-free on request</span></div>\n    <div><b data-slot=\"l3\" data-label=\"Finale\" data-max=\"16\">Finale</b><span data-slot=\"l3-uitleg\" data-label=\"Finale uitleg\" data-max=\"40\">The Oude Markt</span></div>\n  </div>\n</body>\n</html>\n"}