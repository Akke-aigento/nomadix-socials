{"version":1,"width":1080,"height":1920,"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"nx-size\" content=\"1080x1920\">\n<title>Leuven Lore — Fonske</title>\n<style>/* The Fonske Crawl — huisstijl voor Instagram (posts 1080x1350, stories/reels 1080x1920).\n   Afgeleid van fonskecrawl.com (repo fonske-crawl-hq, src/styles.css): warm bijna-zwart, amber/goud, crème.\n   Fonts: Bebas Neue (titels) en Space Grotesk (tekst), beide OFL, lokaal in ./fonts. */\n\n@font-face { font-family: \"Bebas Neue\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/bebas-neue-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n\n:root {\n  --ink: #110C08;        /* achtergrond (site --background) */\n  --card: #1D1711;       /* vlakken */\n  --line: rgba(244,241,236,.14);\n  --amber: #F4A434;      /* primair (site --primary) */\n  --gold-a: #F6CB6A;     /* goudverloop begin */\n  --gold-b: #E58A2A;     /* goudverloop eind */\n  --red: #D45A4F;        /* accent, spaarzaam (site --accent): deadlines */\n  --cream: #F4F1EC;      /* tekst */\n  --mute: #B7A894;\n  --pad: 80px;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { width: 100%; height: 100%; }\nbody {\n  background:\n    radial-gradient(110% 70% at 50% 0%, rgba(150,95,30,.38) 0%, transparent 62%),\n    radial-gradient(70% 50% at 100% 100%, rgba(120,70,20,.22) 0%, transparent 70%),\n    linear-gradient(180deg, #17110B 0%, var(--ink) 100%);\n  color: var(--cream);\n  font-family: \"Space Grotesk\", sans-serif; -webkit-font-smoothing: antialiased;\n  overflow: hidden; position: relative;\n}\n.grain { position: absolute; inset: 0; opacity: .14; mix-blend-mode: overlay; pointer-events: none;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>\"); }\n\n/* Typografie */\n.display { font-family: \"Bebas Neue\", sans-serif; font-weight: 400; line-height: .88; letter-spacing: .01em; text-transform: uppercase; }\n.d-xxl { font-size: 260px; }\n.d-xl { font-size: 190px; }\n.d-l  { font-size: 140px; }\n.d-m  { font-size: 96px; }\n.d-s  { font-size: 60px; }\n.gold { background: linear-gradient(100deg, var(--gold-a) 0%, var(--gold-b) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }\n.amber { color: var(--amber); }\n.red { color: var(--red); }\n.lead { font-size: 38px; line-height: 1.32; font-weight: 500; color: rgba(244,241,236,.92); }\n.body { font-size: 30px; line-height: 1.45; color: rgba(244,241,236,.82); }\n.kicker { font-size: 24px; font-weight: 700; letter-spacing: .26em; text-transform: uppercase; color: var(--amber); }\n.small { font-size: 24px; letter-spacing: .08em; color: var(--mute); }\n\n/* Logo */\n.mark { position: absolute; height: auto; }\n.wordmark { font-family: \"Bebas Neue\", sans-serif; font-size: 40px; letter-spacing: .06em; color: var(--cream); }\n.brandrow { position: absolute; display: flex; align-items: center; gap: 18px; }\n.brandrow img { width: 58px; height: auto; }\n\n/* Info-rijen (wanneer / waar / prijs) */\n.rows { display: grid; }\n.row { display: flex; align-items: baseline; gap: 28px; padding: 24px 0; border-top: 2px solid var(--line); }\n.row:last-child { border-bottom: 2px solid var(--line); }\n.row .k { min-width: 190px; font-size: 24px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--mute); }\n.row .v { font-family: \"Bebas Neue\", sans-serif; font-size: 64px; line-height: 1; color: var(--cream); }\n\n/* Genummerde stappen */\n.step { display: flex; gap: 34px; align-items: flex-start; }\n.step .n { font-family: \"Bebas Neue\", sans-serif; font-size: 150px; line-height: .78; color: transparent; -webkit-text-stroke: 2px var(--amber); min-width: 110px; }\n.step .t { font-family: \"Bebas Neue\", sans-serif; font-size: 66px; line-height: .95; text-transform: uppercase; }\n.step .s { font-size: 28px; line-height: 1.4; color: rgba(244,241,236,.78); margin-top: 10px; }\n\n/* Prijs, pil en ticket-stub */\n.pill { display: inline-flex; align-items: center; gap: 14px; padding: 20px 32px; border-radius: 999px; font-size: 28px; font-weight: 700; }\n.pill.amber { background: var(--amber); color: var(--ink); }\n.pill.ghost { border: 2px solid var(--line); color: var(--cream); }\n.stub { display: flex; align-items: stretch; border: 2px dashed rgba(244,164,52,.55); border-radius: 28px; overflow: hidden; }\n.stub .p { padding: 26px 36px; font-family: \"Bebas Neue\", sans-serif; font-size: 120px; line-height: .9; background: rgba(244,164,52,.1); }\n.stub .i { padding: 28px 34px; display: flex; flex-direction: column; justify-content: center; gap: 8px; border-left: 2px dashed rgba(244,164,52,.55); }\n.strike-none { text-decoration: none; }\n\n/* Stories met een link-sticker: laat rond y 1300–1560 een vrije strook (geen tekst), daar komt de sticker. */\n\n/* Veilige zones voor stories/reels: boven 250 px en onder 340 px vrij van tekst */\n.story-safe { position: absolute; top: 250px; bottom: 340px; left: var(--pad); right: var(--pad); }\n</style>\n<!-- Story met link-sticker. Feiten: Fons Sapientiae, 1975, 550 jaar KU Leuven, giet water over zijn hoofd. Illustratie: fonske.svg -->\n<style>\nbody.v-x { background: #F4A434; }\n.v-x .display, .v-x .lead, .v-x .body {color:#110C08} .v-x .kicker {color:#110C08; opacity:.7}\n</style>\n</head>\n<body class=\"v-x\">\n  <div class=\"grain\"></div>\n  <div class=\"brandrow\" style=\"top:250px; left:var(--pad)\"><span class=\"wordmark\" style=\"color:#110C08\">The Fonske Crawl</span></div>\n  <div style=\"position:absolute; left:var(--pad); right:var(--pad); top:350px; display:flex; flex-direction:column; gap:30px\">\n    <div class=\"kicker\" data-slot=\"reeks\" data-label=\"Reeks\" data-max=\"26\">Leuven Lore · 02</div>\n    <h1 class=\"display d-l\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"60\">Officially, it's water.</h1>\n    <p class=\"lead\" data-slot=\"tekst\" data-label=\"Tekst\" data-max=\"170\" data-multiline=\"true\">Fonske pours knowledge into his head since 1975, a gift for the university's 550th birthday. Students have their own theory.</p>\n  </div>\n  <svg style=\"position:absolute; left:40px; bottom:0; width:1000px; height:1100px\" preserveAspectRatio=\"xMidYMax meet\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1000 1100\">\n  \n  <defs>\n    <linearGradient id=\"beer\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n      <stop offset=\"0\" stop-color=\"#FFE7A8\"/><stop offset=\"1\" stop-color=\"#C4650F\"/>\n    </linearGradient>\n  </defs>\n  <g fill=\"none\" stroke=\"#110C08\" stroke-width=\"9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    \n    <path d=\"M220 1040 L780 1040\"/>\n    <path d=\"M260 1040 L290 900 L710 900 L740 1040\"/>\n    <path d=\"M330 900 L330 850 L670 850 L670 900\"/>\n    \n    <path d=\"M430 850 L450 700\"/><path d=\"M570 850 L545 700\"/>\n    <path d=\"M400 850 L460 850\"/><path d=\"M545 850 L610 850\"/>\n    \n    <path d=\"M440 710 C420 620 430 560 470 520 L540 520 C580 560 585 620 560 710 Z\"/>\n    \n    <circle cx=\"500\" cy=\"440\" r=\"70\"/>\n    \n    <path d=\"M455 560 C400 600 370 620 340 610\"/>\n    \n    <path d=\"M545 550 C610 520 640 420 620 330\"/>\n  </g>\n  \n  <g stroke=\"#110C08\" stroke-width=\"8\" stroke-linejoin=\"round\" fill=\"#F4F1EC\">\n    <path d=\"M250 560 L340 590 L340 660 L250 630 Z\"/>\n    <path d=\"M340 590 L420 560 L420 630 L340 660 Z\"/>\n  </g>\n  <g stroke=\"#110C08\" stroke-width=\"4\" stroke-linecap=\"round\" opacity=\".6\">\n    <path d=\"M268 590 L322 607\"/><path d=\"M268 610 L322 627\"/><path d=\"M358 607 L404 590\"/><path d=\"M358 627 L404 610\"/>\n  </g>\n  \n  <g transform=\"translate(610 300) rotate(-125)\">\n    <path d=\"M-38 -60 L38 -60 L30 60 L-30 60 Z\" fill=\"#F4F1EC\" stroke=\"#110C08\" stroke-width=\"8\" stroke-linejoin=\"round\"/>\n    <path d=\"M-34 -20 L34 -20 L30 60 L-30 60 Z\" fill=\"url(\"#beer\")\"/>\n  </g>\n  <path d=\"M575 318 C545 330 515 345 500 385\" stroke=\"#110C08\" stroke-width=\"34\" stroke-linecap=\"round\" fill=\"none\"/>\n  <path d=\"M575 318 C545 330 515 345 500 385\" stroke=\"#E8952A\" stroke-width=\"20\" stroke-linecap=\"round\" fill=\"none\"/>\n  <path d=\"M570 322 C548 332 528 344 516 362\" stroke=\"#FFE7A8\" stroke-width=\"6\" stroke-linecap=\"round\" fill=\"none\"/>\n  <g fill=\"#F4F1EC\" stroke=\"#110C08\" stroke-width=\"4\">\n    <circle cx=\"590\" cy=\"292\" r=\"9\"/><circle cx=\"575\" cy=\"270\" r=\"6\"/><circle cx=\"604\" cy=\"268\" r=\"5\"/>\n  </g>\n  \n  <path d=\"M445 395 C470 370 530 370 555 395 C530 410 470 410 445 395 Z\" fill=\"#FFF6DD\" stroke=\"#110C08\" stroke-width=\"7\" stroke-linejoin=\"round\"/>\n  \n  <g fill=\"#110C08\"><circle cx=\"420\" cy=\"380\" r=\"6\"/><circle cx=\"400\" cy=\"350\" r=\"4\"/><circle cx=\"585\" cy=\"410\" r=\"5\"/></g>\n  \n  <g stroke=\"#110C08\" stroke-width=\"5\" stroke-linecap=\"round\" fill=\"none\" opacity=\".6\">\n    <path d=\"M330 960 q20 -14 40 0 t40 0\"/><path d=\"M560 990 q20 -14 40 0 t40 0\"/><path d=\"M440 1000 q20 -14 40 0\"/>\n  </g>\n</svg>\n\n</body>\n</html>\n"}