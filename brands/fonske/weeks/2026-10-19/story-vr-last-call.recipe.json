{"version":1,"width":1080,"height":1920,"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"nx-size\" content=\"1080x1920\">\n<title>Last call €19</title>\n<style>/* The Fonske Crawl — huisstijl voor Instagram (posts 1080x1350, stories/reels 1080x1920).\n   Afgeleid van fonskecrawl.com (repo fonske-crawl-hq, src/styles.css): warm bijna-zwart, amber/goud, crème.\n   Fonts: Bebas Neue (titels) en Space Grotesk (tekst), beide OFL, lokaal in ./fonts. */\n\n@font-face { font-family: \"Bebas Neue\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/bebas-neue-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"Space Grotesk\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/fonts/space-grotesk-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n\n:root {\n  --ink: #110C08;        /* achtergrond (site --background) */\n  --card: #1D1711;       /* vlakken */\n  --line: rgba(244,241,236,.14);\n  --amber: #F4A434;      /* primair (site --primary) */\n  --gold-a: #F6CB6A;     /* goudverloop begin */\n  --gold-b: #E58A2A;     /* goudverloop eind */\n  --red: #D45A4F;        /* accent, spaarzaam (site --accent): deadlines */\n  --cream: #F4F1EC;      /* tekst */\n  --mute: #B7A894;\n  --pad: 80px;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { width: 100%; height: 100%; }\nbody {\n  background:\n    radial-gradient(110% 70% at 50% 0%, rgba(150,95,30,.38) 0%, transparent 62%),\n    radial-gradient(70% 50% at 100% 100%, rgba(120,70,20,.22) 0%, transparent 70%),\n    linear-gradient(180deg, #17110B 0%, var(--ink) 100%);\n  color: var(--cream);\n  font-family: \"Space Grotesk\", sans-serif; -webkit-font-smoothing: antialiased;\n  overflow: hidden; position: relative;\n}\n.grain { position: absolute; inset: 0; opacity: .14; mix-blend-mode: overlay; pointer-events: none;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/%2523n\")'/></svg>\"); }\n\n/* Typografie */\n.display { font-family: \"Bebas Neue\", sans-serif; font-weight: 400; line-height: .88; letter-spacing: .01em; text-transform: uppercase; }\n.d-xxl { font-size: 260px; }\n.d-xl { font-size: 190px; }\n.d-l  { font-size: 140px; }\n.d-m  { font-size: 96px; }\n.d-s  { font-size: 60px; }\n.gold { background: linear-gradient(100deg, var(--gold-a) 0%, var(--gold-b) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }\n.amber { color: var(--amber); }\n.red { color: var(--red); }\n.lead { font-size: 38px; line-height: 1.32; font-weight: 500; color: rgba(244,241,236,.92); }\n.body { font-size: 30px; line-height: 1.45; color: rgba(244,241,236,.82); }\n.kicker { font-size: 24px; font-weight: 700; letter-spacing: .26em; text-transform: uppercase; color: var(--amber); }\n.small { font-size: 24px; letter-spacing: .08em; color: var(--mute); }\n\n/* Logo */\n.mark { position: absolute; height: auto; }\n.wordmark { font-family: \"Bebas Neue\", sans-serif; font-size: 40px; letter-spacing: .06em; color: var(--cream); }\n.brandrow { position: absolute; display: flex; align-items: center; gap: 18px; }\n.brandrow img { width: 58px; height: auto; }\n\n/* Info-rijen (wanneer / waar / prijs) */\n.rows { display: grid; }\n.row { display: flex; align-items: baseline; gap: 28px; padding: 24px 0; border-top: 2px solid var(--line); }\n.row:last-child { border-bottom: 2px solid var(--line); }\n.row .k { min-width: 190px; font-size: 24px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--mute); }\n.row .v { font-family: \"Bebas Neue\", sans-serif; font-size: 64px; line-height: 1; color: var(--cream); }\n\n/* Genummerde stappen */\n.step { display: flex; gap: 34px; align-items: flex-start; }\n.step .n { font-family: \"Bebas Neue\", sans-serif; font-size: 150px; line-height: .78; color: transparent; -webkit-text-stroke: 2px var(--amber); min-width: 110px; }\n.step .t { font-family: \"Bebas Neue\", sans-serif; font-size: 66px; line-height: .95; text-transform: uppercase; }\n.step .s { font-size: 28px; line-height: 1.4; color: rgba(244,241,236,.78); margin-top: 10px; }\n\n/* Prijs, pil en ticket-stub */\n.pill { display: inline-flex; align-items: center; gap: 14px; padding: 20px 32px; border-radius: 999px; font-size: 28px; font-weight: 700; }\n.pill.amber { background: var(--amber); color: var(--ink); }\n.pill.ghost { border: 2px solid var(--line); color: var(--cream); }\n.stub { display: flex; align-items: stretch; border: 2px dashed rgba(244,164,52,.55); border-radius: 28px; overflow: hidden; }\n.stub .p { padding: 26px 36px; font-family: \"Bebas Neue\", sans-serif; font-size: 120px; line-height: .9; background: rgba(244,164,52,.1); }\n.stub .i { padding: 28px 34px; display: flex; flex-direction: column; justify-content: center; gap: 8px; border-left: 2px dashed rgba(244,164,52,.55); }\n.strike-none { text-decoration: none; }\n\n/* Stories met een link-sticker: laat rond y 1300–1560 een vrije strook (geen tekst), daar komt de sticker. */\n\n/* Veilige zones voor stories/reels: boven 250 px en onder 340 px vrij van tekst */\n.story-safe { position: absolute; top: 250px; bottom: 340px; left: var(--pad); right: var(--pad); }\n</style>\n<!-- Story met link-sticker. Early bird stopt vr 23-10 om 22:00. Illustratie: last-call.svg -->\n<style>\nbody.v-red { background: #D45A4F; }\n.v-red .kicker{color:#F4F1EC}\n</style>\n</head>\n<body class=\"v-red\">\n  <div class=\"grain\"></div>\n  <div class=\"brandrow\" style=\"top:250px; left:var(--pad)\"><img src=\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/fonske/logo-mark.png\" alt=\"\"><span class=\"wordmark\">The Fonske Crawl</span></div>\n  <div style=\"position:absolute; left:var(--pad); right:var(--pad); top:370px\">\n    <div class=\"kicker\" data-slot=\"kicker\" data-label=\"Kicker\" data-max=\"30\">Early bird ends tonight</div>\n    <h1 class=\"display d-xl\" style=\"margin-top:20px\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"30\">Last call<br>for €19.</h1>\n    <p class=\"lead\" style=\"margin-top:28px\" data-slot=\"tekst\" data-label=\"Tekst\" data-max=\"90\" data-multiline=\"true\">Until 22:00. Tomorrow it's €25, and tomorrow is the crawl.</p>\n  </div>\n  <svg style=\"position:absolute; left:40px; bottom:40px; width:1000px; height:900px\" preserveAspectRatio=\"xMidYMax meet\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1000 900\">\n  \n  <g fill=\"none\" stroke=\"#F4F1EC\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <path d=\"M430 90 L430 160 M570 90 L570 160 M400 90 L600 90\" stroke-width=\"10\"/>\n    <circle cx=\"500\" cy=\"440\" r=\"290\" stroke-width=\"12\" fill=\"#B9473E\"/>\n    <circle cx=\"500\" cy=\"440\" r=\"250\" stroke-width=\"4\" opacity=\".5\"/>\n  </g>\n  \n  <g stroke=\"#F4F1EC\" stroke-width=\"10\" stroke-linecap=\"round\">\n    <path d=\"M500 210 L500 250\"/><path d=\"M500 630 L500 670\"/><path d=\"M270 440 L310 440\"/><path d=\"M690 440 L730 440\"/>\n    <path d=\"M385 241 L400 267\"/><path d=\"M615 241 L600 267\"/><path d=\"M301 325 L327 340\"/><path d=\"M699 325 L673 340\"/>\n    <path d=\"M301 555 L327 540\"/><path d=\"M699 555 L673 540\"/><path d=\"M385 639 L400 613\"/><path d=\"M615 639 L600 613\"/>\n  </g>\n  \n  <g stroke=\"#F4F1EC\" stroke-linecap=\"round\">\n    <path d=\"M500 440 L366 363\" stroke-width=\"18\"/>\n    <path d=\"M500 440 L500 230\" stroke-width=\"12\"/>\n  </g>\n  <circle cx=\"500\" cy=\"440\" r=\"20\" fill=\"#F6CB6A\" stroke=\"#F4F1EC\" stroke-width=\"6\"/>\n  \n  <g transform=\"translate(790 720) rotate(12)\">\n    <path d=\"M-70 -110 H70 L52 110 H-52 Z\" fill=\"#F4F1EC\" stroke=\"#110C08\" stroke-width=\"8\" stroke-linejoin=\"round\"/>\n    <path d=\"M-62 -40 H62 L52 110 H-52 Z\" fill=\"#F4A434\"/>\n    <path d=\"M-52 110 H52\" stroke=\"#110C08\" stroke-width=\"8\"/>\n  </g>\n  <g fill=\"#F6CB6A\"><circle cx=\"700\" cy=\"560\" r=\"10\"/><circle cx=\"680\" cy=\"600\" r=\"6\"/><circle cx=\"880\" cy=\"560\" r=\"8\"/></g>\n</svg>\n\n</body>\n</html>\n"}