{"version":1,"width":1080,"height":1350,"html":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"nx-size\" content=\"1080x1350\">\n<title>Manual: blows vs resets</title><style>/* VanXcel — huisstijl voor Instagram (posts 1080x1350, stories/reels 1080x1920).\n   Afgeleid van vanxcel.com: bijna-zwart, petrol (primair), amber (accent, max. één element per beeld).\n   Fonts: Bebas Neue (titels) en Inter (tekst), beide OFL, lokaal in ./fonts. */\n\n@font-face { font-family: \"Bebas Neue\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/fonts/bebas-neue-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/fonts/inter-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/fonts/inter-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/fonts/inter-latin-600-normal.woff2\") format(\"woff2\"); font-weight: 600; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/fonts/inter-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n\n:root {\n  --ink: #0A0A0A;        /* achtergrond */\n  --card: #141414;       /* vlakken */\n  --line: rgba(255,255,255,.12);\n  --petrol: #008894;     /* primair */\n  --petrol-glow: rgba(0,136,148,.35);\n  --amber: #F59E0B;      /* accent, spaarzaam */\n  --white: #FFFFFF;\n  --mute: #A3A3A3;\n  --pad: 72px;           /* buitenmarge posts */\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { width: 100%; height: 100%; }\nbody {\n  background: var(--ink); color: var(--white);\n  font-family: \"Inter\", sans-serif; -webkit-font-smoothing: antialiased;\n  overflow: hidden; position: relative;\n}\n\n/* Typografie */\n.display { font-family: \"Bebas Neue\", sans-serif; font-weight: 400; line-height: .9; letter-spacing: .01em; text-transform: uppercase; }\n.d-xl { font-size: 168px; }\n.d-l  { font-size: 124px; }\n.d-m  { font-size: 88px; }\n.d-s  { font-size: 56px; }\n.lead { font-size: 34px; line-height: 1.35; font-weight: 500; color: rgba(255,255,255,.9); }\n.body { font-size: 28px; line-height: 1.45; color: rgba(255,255,255,.82); }\n.kicker { font-size: 22px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--petrol); }\n.amber { color: var(--amber); }\n.petrol { color: var(--petrol); }\n\n/* Foto full-bleed met donkere verloopband onderaan of bovenaan */\n.photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }\n.shade-bottom { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,10,0) 35%, rgba(10,10,10,.55) 62%, rgba(10,10,10,.96) 100%); }\n.shade-top { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(10,10,10,0) 45%, rgba(10,10,10,.85) 100%); }\n.grain { position: absolute; inset: 0; opacity: .08; mix-blend-mode: overlay;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>\"); }\n\n/* Logo */\n.logo { position: absolute; width: 190px; height: auto; }\n.logo.tl { top: 64px; left: var(--pad); }\n.logo.tr { top: 64px; right: var(--pad); }\n.logo.bl { bottom: 64px; left: var(--pad); }\n\n/* Plaats/datum-stempel (\"journey stamp\") */\n.stamp { display: inline-flex; align-items: center; gap: 16px; font-size: 22px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--white); }\n.stamp .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--amber); box-shadow: 0 0 0 6px rgba(245,158,11,.22); }\n.stamp .sep { width: 36px; height: 2px; background: var(--line); }\n\n/* De \"journey line\": terugkerende routelijn */\n.jline { position: absolute; left: var(--pad); right: var(--pad); height: 2px; background: linear-gradient(90deg, var(--petrol), rgba(0,136,148,.15)); }\n\n/* Product op zwart met petrol gloed */\n.glow { position: absolute; border-radius: 50%; filter: blur(90px); background: var(--petrol-glow); }\n.product { position: absolute; object-fit: contain; filter: drop-shadow(0 30px 40px rgba(0,0,0,.6)); }\n\n/* Specs */\n.specs { display: grid; gap: 18px; }\n.spec { display: flex; align-items: baseline; gap: 22px; padding: 22px 0; border-top: 1px solid var(--line); }\n.spec .v { font-family: \"Bebas Neue\", sans-serif; font-size: 64px; line-height: 1; color: var(--white); min-width: 230px; }\n.spec .l { font-size: 26px; color: var(--mute); line-height: 1.3; }\n\n/* Prijs- en CTA-pil */\n.pill { display: inline-flex; align-items: center; gap: 14px; padding: 18px 28px; border-radius: 999px; font-size: 26px; font-weight: 700; }\n.pill.petrol { background: var(--petrol); color: var(--white); }\n.pill.ghost { border: 2px solid var(--line); color: var(--white); }\n.price { font-family: \"Bebas Neue\", sans-serif; font-size: 96px; line-height: 1; }\n\n/* Genummerde tipkaart */\n.num { font-family: \"Bebas Neue\", sans-serif; font-size: 300px; line-height: .8; color: transparent; -webkit-text-stroke: 2px var(--petrol); }\n.warn { display: flex; gap: 18px; align-items: flex-start; padding: 26px 30px; border-left: 6px solid var(--amber); background: rgba(245,158,11,.08); font-size: 26px; line-height: 1.4; }\n\n/* Veilige zones voor stories/reels: boven 250 px en onder 340 px vrij van tekst */\n.story-safe { position: absolute; top: 250px; bottom: 340px; left: var(--pad); right: var(--pad); }\n</style>\n<!-- genre: handleiding (B). Specs en prijzen live uit SellQo (16-11): Automatic Fuse 100A €26.95, 150A €23.95. -->\n<style>\nbody{background:#f1efe9;color:#111}\n.hd{position:absolute;left:70px;right:70px;top:60px;display:flex;justify-content:space-between;align-items:flex-end;border-bottom:6px solid #111;padding-bottom:18px}\n.hd h1{font:400 100px/.85 \"Bebas Neue\";margin:0}\n.hd .no{font:700 24px Inter;letter-spacing:.12em}\n.cols{position:absolute;left:70px;right:70px;top:290px;display:grid;grid-template-columns:1fr 1fr;gap:40px}\n.col h2{font:400 54px \"Bebas Neue\";margin:0 0 18px;display:flex;gap:14px;align-items:center}\n.col h2 i{font-style:normal;width:52px;height:52px;border-radius:50%;background:#111;color:#fff;display:grid;place-items:center;font-size:36px}\n.col.b h2 i{background:var(--petrol)}\n.step{display:flex;gap:20px;align-items:center;border:4px solid #111;border-radius:16px;padding:18px;margin-bottom:18px;background:#fff;height:170px}\n.step svg{flex:none;width:130px;height:130px}\n.step p{margin:0;font:600 28px/1.25 Inter}\n.step b{display:block;font:400 40px \"Bebas Neue\";color:#555}\n.col.b .step{border-color:var(--petrol)}\n.spec{position:absolute;left:70px;right:70px;bottom:70px;display:flex;justify-content:space-between;align-items:center;border-top:4px solid #111;padding-top:24px}\n.spec ul{list-style:none;margin:0;padding:0;font:600 24px/1.5 Inter}\n.spec .pr{text-align:right}.spec .pr b{display:block;font:400 110px/.9 \"Bebas Neue\";color:var(--petrol)}\n.spec .pr span{font:600 22px Inter;color:#555}\n.logo{height:40px;margin-top:10px}\n</style></head><body>\n<div class=\"hd\"><h1 data-slot=\"titel\" data-label=\"Title\" data-max=\"24\">One blows. One resets.</h1><div class=\"no\">MANUAL · 100A</div></div>\n<div class=\"cols\">\n<div class=\"col a\"><h2><i>A</i>Standard fuse</h2>\n<div class=\"step\"><svg viewBox=\"0 0 100 100\"><path d=\"M10 50h20l8-18 10 36 10-36 8 18h24\" fill=\"none\" stroke=\"#111\" stroke-width=\"6\"/><path d=\"M60 14l-10 22h12l-10 22\" fill=\"none\" stroke=\"#F59E0B\" stroke-width=\"6\"/></svg><p><b>01</b>Short or overload</p></div>\n<div class=\"step\"><svg viewBox=\"0 0 100 100\"><rect x=\"15\" y=\"35\" width=\"70\" height=\"30\" rx=\"6\" fill=\"none\" stroke=\"#111\" stroke-width=\"6\"/><path d=\"M30 50h14M56 50h14\" stroke=\"#111\" stroke-width=\"6\"/><path d=\"M44 42l12 16M56 42l-12 16\" stroke=\"#111\" stroke-width=\"5\"/></svg><p><b>02</b>It blows</p></div>\n<div class=\"step\"><svg viewBox=\"0 0 100 100\"><rect x=\"15\" y=\"35\" width=\"70\" height=\"30\" rx=\"6\" fill=\"none\" stroke=\"#111\" stroke-width=\"6\"/><path d=\"M50 10v18M42 20l8 8 8-8\" fill=\"none\" stroke=\"#111\" stroke-width=\"6\"/><path d=\"M30 50h40\" stroke=\"#111\" stroke-width=\"6\"/></svg><p><b>03</b>Fit a new one</p></div></div>\n<div class=\"col b\"><h2><i>B</i>Automatic Fuse</h2>\n<div class=\"step\"><svg viewBox=\"0 0 100 100\"><path d=\"M10 50h20l8-18 10 36 10-36 8 18h24\" fill=\"none\" stroke=\"#111\" stroke-width=\"6\"/><path d=\"M60 14l-10 22h12l-10 22\" fill=\"none\" stroke=\"#F59E0B\" stroke-width=\"6\"/></svg><p><b>01</b>Short or overload</p></div>\n<div class=\"step\"><svg viewBox=\"0 0 100 100\"><rect x=\"20\" y=\"20\" width=\"60\" height=\"60\" rx=\"10\" fill=\"none\" stroke=\"#008894\" stroke-width=\"6\"/><circle cx=\"50\" cy=\"50\" r=\"12\" fill=\"#008894\"/><path d=\"M50 50l18-18\" stroke=\"#008894\" stroke-width=\"6\"/></svg><p><b>02</b>It trips</p></div>\n<div class=\"step\"><svg viewBox=\"0 0 100 100\"><path d=\"M78 50a28 28 0 1 1-8-20\" fill=\"none\" stroke=\"#008894\" stroke-width=\"7\"/><path d=\"M72 14v18H54\" fill=\"none\" stroke=\"#008894\" stroke-width=\"7\"/></svg><p><b>03</b>It resets and keeps protecting</p></div></div>\n</div>\n<div class=\"spec\"><ul><li>100A · 12V DC</li><li>Water-resistant ABS housing</li><li>-25°C to +85°C</li><li>Bracket + protective cap included</li><img class=\"logo\" src=\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/logo-black.svg\" alt=\"VanXcel\"></ul>\n<div class=\"pr\"><b>€26.95</b><span>Automatic Fuse 100A<br>also 150A · €23.95</span></div></div>\n</body></html>\n"}