{"version":1,"width":1080,"height":1350,"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"nx-size\" content=\"1080x1350\">\n<title>500W or 1000W power station</title>\n<style>/* VanXcel — huisstijl voor Instagram (posts 1080x1350, stories/reels 1080x1920).\n   Afgeleid van vanxcel.com: bijna-zwart, petrol (primair), amber (accent, max. één element per beeld).\n   Fonts: Bebas Neue (titels) en Inter (tekst), beide OFL, lokaal in ./fonts. */\n\n@font-face { font-family: \"Bebas Neue\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/fonts/bebas-neue-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/fonts/inter-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/fonts/inter-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/fonts/inter-latin-600-normal.woff2\") format(\"woff2\"); font-weight: 600; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/fonts/inter-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n\n:root {\n  --ink: #0A0A0A;        /* achtergrond */\n  --card: #141414;       /* vlakken */\n  --line: rgba(255,255,255,.12);\n  --petrol: #008894;     /* primair */\n  --petrol-glow: rgba(0,136,148,.35);\n  --amber: #F59E0B;      /* accent, spaarzaam */\n  --white: #FFFFFF;\n  --mute: #A3A3A3;\n  --pad: 72px;           /* buitenmarge posts */\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { width: 100%; height: 100%; }\nbody {\n  background: var(--ink); color: var(--white);\n  font-family: \"Inter\", sans-serif; -webkit-font-smoothing: antialiased;\n  overflow: hidden; position: relative;\n}\n\n/* Typografie */\n.display { font-family: \"Bebas Neue\", sans-serif; font-weight: 400; line-height: .9; letter-spacing: .01em; text-transform: uppercase; }\n.d-xl { font-size: 168px; }\n.d-l  { font-size: 124px; }\n.d-m  { font-size: 88px; }\n.d-s  { font-size: 56px; }\n.lead { font-size: 34px; line-height: 1.35; font-weight: 500; color: rgba(255,255,255,.9); }\n.body { font-size: 28px; line-height: 1.45; color: rgba(255,255,255,.82); }\n.kicker { font-size: 22px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--petrol); }\n.amber { color: var(--amber); }\n.petrol { color: var(--petrol); }\n\n/* Foto full-bleed met donkere verloopband onderaan of bovenaan */\n.photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }\n.shade-bottom { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,10,0) 35%, rgba(10,10,10,.55) 62%, rgba(10,10,10,.96) 100%); }\n.shade-top { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(10,10,10,0) 45%, rgba(10,10,10,.85) 100%); }\n.grain { position: absolute; inset: 0; opacity: .08; mix-blend-mode: overlay;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>\"); }\n\n/* Logo */\n.logo { position: absolute; width: 190px; height: auto; }\n.logo.tl { top: 64px; left: var(--pad); }\n.logo.tr { top: 64px; right: var(--pad); }\n.logo.bl { bottom: 64px; left: var(--pad); }\n\n/* Plaats/datum-stempel (\"journey stamp\") */\n.stamp { display: inline-flex; align-items: center; gap: 16px; font-size: 22px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--white); }\n.stamp .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--amber); box-shadow: 0 0 0 6px rgba(245,158,11,.22); }\n.stamp .sep { width: 36px; height: 2px; background: var(--line); }\n\n/* De \"journey line\": terugkerende routelijn */\n.jline { position: absolute; left: var(--pad); right: var(--pad); height: 2px; background: linear-gradient(90deg, var(--petrol), rgba(0,136,148,.15)); }\n\n/* Product op zwart met petrol gloed */\n.glow { position: absolute; border-radius: 50%; filter: blur(90px); background: var(--petrol-glow); }\n.product { position: absolute; object-fit: contain; filter: drop-shadow(0 30px 40px rgba(0,0,0,.6)); }\n\n/* Specs */\n.specs { display: grid; gap: 18px; }\n.spec { display: flex; align-items: baseline; gap: 22px; padding: 22px 0; border-top: 1px solid var(--line); }\n.spec .v { font-family: \"Bebas Neue\", sans-serif; font-size: 64px; line-height: 1; color: var(--white); min-width: 230px; }\n.spec .l { font-size: 26px; color: var(--mute); line-height: 1.3; }\n\n/* Prijs- en CTA-pil */\n.pill { display: inline-flex; align-items: center; gap: 14px; padding: 18px 28px; border-radius: 999px; font-size: 26px; font-weight: 700; }\n.pill.petrol { background: var(--petrol); color: var(--white); }\n.pill.ghost { border: 2px solid var(--line); color: var(--white); }\n.price { font-family: \"Bebas Neue\", sans-serif; font-size: 96px; line-height: 1; }\n\n/* Genummerde tipkaart */\n.num { font-family: \"Bebas Neue\", sans-serif; font-size: 300px; line-height: .8; color: transparent; -webkit-text-stroke: 2px var(--petrol); }\n.warn { display: flex; gap: 18px; align-items: flex-start; padding: 26px 30px; border-left: 6px solid var(--amber); background: rgba(245,158,11,.08); font-size: 26px; line-height: 1.4; }\n\n/* Veilige zones voor stories/reels: boven 250 px en onder 340 px vrij van tekst */\n.story-safe { position: absolute; top: 250px; bottom: 340px; left: var(--pad); right: var(--pad); }\n</style>\n<!-- Product, licht, echte productfoto's (nieuw: compare-rows, rijen i.p.v. kolommen). Prijzen en voorraad live uit SellQo (08-11-2026:\n     500W Powerstation €199 voorraad 3, 1000W Powerstation €415 voorraad 8). Specs uit de SellQo-omschrijvingen:\n     560Wh / 7.85 kg, 1120Wh / 14.6 kg; beide pure sine, UPS, solar 12–30V 120W max, 2x USB-C 60W.\n     Productfoto's: SellQo product-images (eerste foto per product), wit weggewerkt. -->\n<style>\n  body { background:#F4F3EF; color:var(--ink); }\n  .row { display:grid; grid-template-columns:330px 1fr; gap:34px; align-items:center; background:#fff; border-radius:28px; padding:28px 40px 28px 28px; box-shadow:0 10px 30px rgba(10,10,10,.06); }\n  .row img { width:330px; height:250px; object-fit:contain; }\n  .w { font-family:\"Bebas Neue\",sans-serif; font-size:112px; line-height:.85; }\n  .facts { display:flex; gap:28px; margin-top:12px; }\n  .facts div { display:flex; flex-direction:column; }\n  .facts b { font-family:\"Bebas Neue\",sans-serif; font-size:58px; font-weight:400; line-height:1; }\n  .facts span { font-size:22px; color:#666; letter-spacing:.06em; text-transform:uppercase; font-weight:600; }\n  .both { font-size:28px; line-height:1.45; color:#333; }\n  .both b { color:var(--ink); }\n</style>\n</head>\n<body>\n  <img class=\"logo tl\" src=\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/logo-black.svg\" alt=\"VanXcel\">\n  <div class=\"kicker\" style=\"position:absolute; top:78px; right:var(--pad)\" data-slot=\"kicker\" data-label=\"Bovenregel\" data-max=\"24\">Power stations</div>\n  <div style=\"position:absolute; left:var(--pad); right:var(--pad); top:190px; display:flex; flex-direction:column; gap:30px\">\n    <h1 class=\"display\" style=\"font-size:112px\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"40\">Double the watts.<br><span class=\"petrol\">Double the hours.</span></h1>\n    <div class=\"row\">\n      <img src=\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/products/powerstation-500w.png\" alt=\"VanXcel 500W Power Station\">\n      <div>\n        <span class=\"w\" data-slot=\"a\" data-label=\"Model 1\" data-max=\"8\">500W</span>\n        <div class=\"facts\">\n          <div><b data-slot=\"a1\" data-label=\"Capaciteit 1\" data-max=\"8\">560Wh</b><span>capacity</span></div>\n          <div><b data-slot=\"a2\" data-label=\"Gewicht 1\" data-max=\"8\">7.85kg</b><span>weight</span></div>\n          <div><b data-slot=\"ap\" data-label=\"Prijs 1\" data-max=\"8\">€199</b><span>price</span></div>\n        </div>\n      </div>\n    </div>\n    <div class=\"row\">\n      <img src=\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/products/powerstation-1000w.png\" alt=\"VanXcel 1000W Power Station\">\n      <div>\n        <span class=\"w\" data-slot=\"b\" data-label=\"Model 2\" data-max=\"8\">1000W</span>\n        <div class=\"facts\">\n          <div><b data-slot=\"b1\" data-label=\"Capaciteit 2\" data-max=\"8\">1120Wh</b><span>capacity</span></div>\n          <div><b data-slot=\"b2\" data-label=\"Gewicht 2\" data-max=\"8\">14.6kg</b><span>weight</span></div>\n          <div><b data-slot=\"bp\" data-label=\"Prijs 2\" data-max=\"8\">€415</b><span>price</span></div>\n        </div>\n      </div>\n    </div>\n    <p class=\"both\" data-slot=\"beide\" data-label=\"Beide\" data-max=\"140\"><b>Both:</b> pure sine output · UPS function · solar input up to 120W · 2× USB-C 60W.</p>\n  </div>\n  <div style=\"position:absolute; left:var(--pad); right:var(--pad); bottom:64px; display:flex; align-items:center; justify-content:space-between\">\n    <span class=\"pill\" style=\"background:var(--amber); color:var(--ink)\" data-slot=\"cta\" data-label=\"Knop\" data-max=\"34\">Shop → link in bio</span>\n    <span class=\"body\" style=\"color:#666\" data-slot=\"link\" data-label=\"Link\" data-max=\"30\">vanxcel.com</span>\n  </div>\n</body>\n</html>\n"}