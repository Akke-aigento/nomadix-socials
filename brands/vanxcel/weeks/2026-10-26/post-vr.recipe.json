{"version":1,"width":1080,"height":1350,"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"nx-size\" content=\"1080x1350\">\n<title>1000W or 1500W</title>\n<style>/* VanXcel — huisstijl voor Instagram (posts 1080x1350, stories/reels 1080x1920).\n   Afgeleid van vanxcel.com: bijna-zwart, petrol (primair), amber (accent, max. één element per beeld).\n   Fonts: Bebas Neue (titels) en Inter (tekst), beide OFL, lokaal in ./fonts. */\n\n@font-face { font-family: \"Bebas Neue\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/fonts/bebas-neue-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/fonts/inter-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/fonts/inter-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/fonts/inter-latin-600-normal.woff2\") format(\"woff2\"); font-weight: 600; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/fonts/inter-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n\n:root {\n  --ink: #0A0A0A;        /* achtergrond */\n  --card: #141414;       /* vlakken */\n  --line: rgba(255,255,255,.12);\n  --petrol: #008894;     /* primair */\n  --petrol-glow: rgba(0,136,148,.35);\n  --amber: #F59E0B;      /* accent, spaarzaam */\n  --white: #FFFFFF;\n  --mute: #A3A3A3;\n  --pad: 72px;           /* buitenmarge posts */\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { width: 100%; height: 100%; }\nbody {\n  background: var(--ink); color: var(--white);\n  font-family: \"Inter\", sans-serif; -webkit-font-smoothing: antialiased;\n  overflow: hidden; position: relative;\n}\n\n/* Typografie */\n.display { font-family: \"Bebas Neue\", sans-serif; font-weight: 400; line-height: .9; letter-spacing: .01em; text-transform: uppercase; }\n.d-xl { font-size: 168px; }\n.d-l  { font-size: 124px; }\n.d-m  { font-size: 88px; }\n.d-s  { font-size: 56px; }\n.lead { font-size: 34px; line-height: 1.35; font-weight: 500; color: rgba(255,255,255,.9); }\n.body { font-size: 28px; line-height: 1.45; color: rgba(255,255,255,.82); }\n.kicker { font-size: 22px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--petrol); }\n.amber { color: var(--amber); }\n.petrol { color: var(--petrol); }\n\n/* Foto full-bleed met donkere verloopband onderaan of bovenaan */\n.photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }\n.shade-bottom { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,10,0) 35%, rgba(10,10,10,.55) 62%, rgba(10,10,10,.96) 100%); }\n.shade-top { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(10,10,10,0) 45%, rgba(10,10,10,.85) 100%); }\n.grain { position: absolute; inset: 0; opacity: .08; mix-blend-mode: overlay;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>\"); }\n\n/* Logo */\n.logo { position: absolute; width: 190px; height: auto; }\n.logo.tl { top: 64px; left: var(--pad); }\n.logo.tr { top: 64px; right: var(--pad); }\n.logo.bl { bottom: 64px; left: var(--pad); }\n\n/* Plaats/datum-stempel (\"journey stamp\") */\n.stamp { display: inline-flex; align-items: center; gap: 16px; font-size: 22px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--white); }\n.stamp .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--amber); box-shadow: 0 0 0 6px rgba(245,158,11,.22); }\n.stamp .sep { width: 36px; height: 2px; background: var(--line); }\n\n/* De \"journey line\": terugkerende routelijn */\n.jline { position: absolute; left: var(--pad); right: var(--pad); height: 2px; background: linear-gradient(90deg, var(--petrol), rgba(0,136,148,.15)); }\n\n/* Product op zwart met petrol gloed */\n.glow { position: absolute; border-radius: 50%; filter: blur(90px); background: var(--petrol-glow); }\n.product { position: absolute; object-fit: contain; filter: drop-shadow(0 30px 40px rgba(0,0,0,.6)); }\n\n/* Specs */\n.specs { display: grid; gap: 18px; }\n.spec { display: flex; align-items: baseline; gap: 22px; padding: 22px 0; border-top: 1px solid var(--line); }\n.spec .v { font-family: \"Bebas Neue\", sans-serif; font-size: 64px; line-height: 1; color: var(--white); min-width: 230px; }\n.spec .l { font-size: 26px; color: var(--mute); line-height: 1.3; }\n\n/* Prijs- en CTA-pil */\n.pill { display: inline-flex; align-items: center; gap: 14px; padding: 18px 28px; border-radius: 999px; font-size: 26px; font-weight: 700; }\n.pill.petrol { background: var(--petrol); color: var(--white); }\n.pill.ghost { border: 2px solid var(--line); color: var(--white); }\n.price { font-family: \"Bebas Neue\", sans-serif; font-size: 96px; line-height: 1; }\n\n/* Genummerde tipkaart */\n.num { font-family: \"Bebas Neue\", sans-serif; font-size: 300px; line-height: .8; color: transparent; -webkit-text-stroke: 2px var(--petrol); }\n.warn { display: flex; gap: 18px; align-items: flex-start; padding: 26px 30px; border-left: 6px solid var(--amber); background: rgba(245,158,11,.08); font-size: 26px; line-height: 1.4; }\n\n/* Veilige zones voor stories/reels: boven 250 px en onder 340 px vrij van tekst */\n.story-safe { position: absolute; top: 250px; bottom: 340px; left: var(--pad); right: var(--pad); }\n</style>\n<!-- compare-light: lichte vergelijking van twee producten (pijler Product). Prijzen en voorraad live uit SellQo (25-10-2026:\n     5-in-1 1000W €375 voorraad 20, 1500W €475 voorraad 20). Specs: productomschrijvingen + vanxcel.com configurator\n     (pu_VX1000CV/pu_VX1500CV \"up to …W continuous\", pr_converter, pu_VXANL200/250). -->\n<style>\n  body { background:#F4F3EF; color:var(--ink); }\n  .kicker { color:var(--petrol); }\n  .cols { display:grid; grid-template-columns:1fr 1fr; gap:28px; }\n  .col { background:#fff; border-radius:28px; padding:48px 44px 44px; display:flex; flex-direction:column; gap:26px; box-shadow:0 10px 30px rgba(10,10,10,.06); }\n  .col .w { font-family:\"Bebas Neue\",sans-serif; font-size:150px; line-height:.85; }\n  .col .p { font-family:\"Bebas Neue\",sans-serif; font-size:80px; line-height:1; }\n  .col .l { font-size:30px; line-height:1.35; color:#444; border-top:1px solid rgba(10,10,10,.1); padding-top:16px; }\n  .both { font-size:30px; line-height:1.5; color:#333; }\n  .both b { color:var(--ink); }\n</style>\n</head>\n<body>\n  <img class=\"logo tl\" src=\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/logo-black.svg\" alt=\"VanXcel\">\n  <div class=\"kicker\" style=\"position:absolute; top:78px; right:var(--pad)\" data-slot=\"kicker\" data-label=\"Bovenregel\" data-max=\"24\">5-in-1 Converter</div>\n\n  <div style=\"position:absolute; left:var(--pad); right:var(--pad); top:210px; display:flex; flex-direction:column; gap:48px\">\n    <h1 class=\"display d-l\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"34\">Same five jobs.<br><span class=\"petrol\">Two sizes.</span></h1>\n    <div class=\"cols\">\n      <div class=\"col\">\n        <span class=\"w\" data-slot=\"a\" data-label=\"Model 1\" data-max=\"6\">1000W</span>\n        <span class=\"p\" data-slot=\"ap\" data-label=\"Prijs 1\" data-max=\"8\">€375</span>\n        <span class=\"l\" data-slot=\"al\" data-label=\"Tekst 1\" data-max=\"60\">Up to 1000W continuous. For weekend campers and lighter setups.</span>\n      </div>\n      <div class=\"col\">\n        <span class=\"w\" data-slot=\"b\" data-label=\"Model 2\" data-max=\"6\">1500W</span>\n        <span class=\"p\" data-slot=\"bp\" data-label=\"Prijs 2\" data-max=\"8\">€475</span>\n        <span class=\"l\" data-slot=\"bl\" data-label=\"Tekst 2\" data-max=\"60\">Up to 1500W continuous. For active campers and full-timers.</span>\n      </div>\n    </div>\n    <p class=\"both\" data-slot=\"beide\" data-label=\"Beide\" data-max=\"160\"><b>Both:</b> pure sine inverter · 25A DC-DC charger · MPPT solar up to 500Wp · shore power charger · UPS · wired remote.</p>\n  </div>\n\n  <div style=\"position:absolute; left:var(--pad); right:var(--pad); bottom:72px; display:flex; align-items:center; justify-content:space-between\">\n    <span class=\"pill\" style=\"background:var(--amber); color:var(--ink)\" data-slot=\"cta\" data-label=\"Knop\" data-max=\"34\">Not sure? Configurator</span>\n    <span class=\"body\" style=\"color:#666\" data-slot=\"link\" data-label=\"Link\" data-max=\"30\">vanxcel.com/configurator</span>\n  </div>\n</body>\n</html>\n"}