{"version":1,"width":1080,"height":1350,"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"nx-size\" content=\"1080x1350\">\n<title>Fuse Holder 12 slots</title>\n<style>/* VanXcel — huisstijl voor Instagram (posts 1080x1350, stories/reels 1080x1920).\n   Afgeleid van vanxcel.com: bijna-zwart, petrol (primair), amber (accent, max. één element per beeld).\n   Fonts: Bebas Neue (titels) en Inter (tekst), beide OFL, lokaal in ./fonts. */\n\n@font-face { font-family: \"Bebas Neue\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/fonts/bebas-neue-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/fonts/inter-latin-400-normal.woff2\") format(\"woff2\"); font-weight: 400; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/fonts/inter-latin-500-normal.woff2\") format(\"woff2\"); font-weight: 500; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/fonts/inter-latin-600-normal.woff2\") format(\"woff2\"); font-weight: 600; }\n@font-face { font-family: \"Inter\"; src: url(\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/fonts/inter-latin-700-normal.woff2\") format(\"woff2\"); font-weight: 700; }\n\n:root {\n  --ink: #0A0A0A;        /* achtergrond */\n  --card: #141414;       /* vlakken */\n  --line: rgba(255,255,255,.12);\n  --petrol: #008894;     /* primair */\n  --petrol-glow: rgba(0,136,148,.35);\n  --amber: #F59E0B;      /* accent, spaarzaam */\n  --white: #FFFFFF;\n  --mute: #A3A3A3;\n  --pad: 72px;           /* buitenmarge posts */\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { width: 100%; height: 100%; }\nbody {\n  background: var(--ink); color: var(--white);\n  font-family: \"Inter\", sans-serif; -webkit-font-smoothing: antialiased;\n  overflow: hidden; position: relative;\n}\n\n/* Typografie */\n.display { font-family: \"Bebas Neue\", sans-serif; font-weight: 400; line-height: .9; letter-spacing: .01em; text-transform: uppercase; }\n.d-xl { font-size: 168px; }\n.d-l  { font-size: 124px; }\n.d-m  { font-size: 88px; }\n.d-s  { font-size: 56px; }\n.lead { font-size: 34px; line-height: 1.35; font-weight: 500; color: rgba(255,255,255,.9); }\n.body { font-size: 28px; line-height: 1.45; color: rgba(255,255,255,.82); }\n.kicker { font-size: 22px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--petrol); }\n.amber { color: var(--amber); }\n.petrol { color: var(--petrol); }\n\n/* Foto full-bleed met donkere verloopband onderaan of bovenaan */\n.photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }\n.shade-bottom { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,10,0) 35%, rgba(10,10,10,.55) 62%, rgba(10,10,10,.96) 100%); }\n.shade-top { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(10,10,10,0) 45%, rgba(10,10,10,.85) 100%); }\n.grain { position: absolute; inset: 0; opacity: .08; mix-blend-mode: overlay;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>\"); }\n\n/* Logo */\n.logo { position: absolute; width: 190px; height: auto; }\n.logo.tl { top: 64px; left: var(--pad); }\n.logo.tr { top: 64px; right: var(--pad); }\n.logo.bl { bottom: 64px; left: var(--pad); }\n\n/* Plaats/datum-stempel (\"journey stamp\") */\n.stamp { display: inline-flex; align-items: center; gap: 16px; font-size: 22px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--white); }\n.stamp .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--amber); box-shadow: 0 0 0 6px rgba(245,158,11,.22); }\n.stamp .sep { width: 36px; height: 2px; background: var(--line); }\n\n/* De \"journey line\": terugkerende routelijn */\n.jline { position: absolute; left: var(--pad); right: var(--pad); height: 2px; background: linear-gradient(90deg, var(--petrol), rgba(0,136,148,.15)); }\n\n/* Product op zwart met petrol gloed */\n.glow { position: absolute; border-radius: 50%; filter: blur(90px); background: var(--petrol-glow); }\n.product { position: absolute; object-fit: contain; filter: drop-shadow(0 30px 40px rgba(0,0,0,.6)); }\n\n/* Specs */\n.specs { display: grid; gap: 18px; }\n.spec { display: flex; align-items: baseline; gap: 22px; padding: 22px 0; border-top: 1px solid var(--line); }\n.spec .v { font-family: \"Bebas Neue\", sans-serif; font-size: 64px; line-height: 1; color: var(--white); min-width: 230px; }\n.spec .l { font-size: 26px; color: var(--mute); line-height: 1.3; }\n\n/* Prijs- en CTA-pil */\n.pill { display: inline-flex; align-items: center; gap: 14px; padding: 18px 28px; border-radius: 999px; font-size: 26px; font-weight: 700; }\n.pill.petrol { background: var(--petrol); color: var(--white); }\n.pill.ghost { border: 2px solid var(--line); color: var(--white); }\n.price { font-family: \"Bebas Neue\", sans-serif; font-size: 96px; line-height: 1; }\n\n/* Genummerde tipkaart */\n.num { font-family: \"Bebas Neue\", sans-serif; font-size: 300px; line-height: .8; color: transparent; -webkit-text-stroke: 2px var(--petrol); }\n.warn { display: flex; gap: 18px; align-items: flex-start; padding: 26px 30px; border-left: 6px solid var(--amber); background: rgba(245,158,11,.08); font-size: 26px; line-height: 1.4; }\n\n/* Veilige zones voor stories/reels: boven 250 px en onder 340 px vrij van tekst */\n.story-safe { position: absolute; top: 250px; bottom: 340px; left: var(--pad); right: var(--pad); }\n</style>\n<!-- fuse-map (nieuw), licht, pijler Product. SellQo 01-11-2026: VanXcel Fuse Holder 12 slots, €33.95, voorraad 30.\n     Specs uit de productomschrijving (12 slots, LED-indicator bij doorgeslagen zekering, doorzichtig deksel met labels,\n     zekeringen 5–20A bij, tot 30A per circuit, 100A totaal, 12–32V DC). Voorbeeldindeling = vanxcel.com configurator\n     phase2Step5 (lighting 5A, USB 5A, fridge 10A, water pump 5A, diesel heater 10A, roof vent 5A). Schema, geen productfoto. -->\n<style>\n  body { background:#F4F3EF; color:var(--ink); }\n  .grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; background:var(--ink); padding:26px; border-radius:26px; }\n  .slot { background:#1d1d1d; border-radius:14px; height:150px; padding:18px 18px 16px; display:flex; flex-direction:column; justify-content:space-between; position:relative; }\n  .slot .a { font-family:\"Bebas Neue\",sans-serif; font-size:60px; line-height:1; color:#fff; }\n  .slot .n { font-size:19px; font-weight:600; color:var(--mute); line-height:1.2; }\n  .slot.on { outline:3px solid var(--petrol); }\n  .slot .led { position:absolute; top:18px; right:18px; width:16px; height:16px; border-radius:50%; background:#2c2c2c; }\n  .slot.blown .led { background:var(--amber); box-shadow:0 0 0 6px rgba(245,158,11,.25), 0 0 22px rgba(245,158,11,.8); }\n  .slot.spare .a { color:#3a3a3a; }\n  .facts { display:flex; flex-wrap:wrap; gap:10px 28px; font-size:25px; color:#333; }\n  .facts span::before { content:\"\"; display:inline-block; width:10px; height:10px; border-radius:50%; background:var(--petrol); margin-right:12px; vertical-align:middle; }\n</style>\n</head>\n<body>\n  <img class=\"logo tl\" src=\"https://raw.githubusercontent.com/Akke-aigento/nomadix-socials/main/brands/vanxcel/logo-black.svg\" alt=\"VanXcel\">\n  <div class=\"kicker\" style=\"position:absolute; top:78px; right:var(--pad)\" data-slot=\"kicker\" data-label=\"Bovenregel\" data-max=\"24\">Fuse Holder · 12 slots</div>\n  <div style=\"position:absolute; left:var(--pad); right:var(--pad); top:190px; display:flex; flex-direction:column; gap:30px\">\n    <h1 class=\"display\" style=\"font-size:110px\" data-slot=\"titel\" data-label=\"Titel\" data-max=\"44\">One circuit. One slot.<br><span class=\"petrol\">One label.</span></h1>\n    <div class=\"grid\">\n      <div class=\"slot on\"><span class=\"a\">5A</span><span class=\"n\">Lighting</span></div>\n      <div class=\"slot on\"><span class=\"a\">5A</span><span class=\"n\">USB</span></div>\n      <div class=\"slot on\"><span class=\"a\">10A</span><span class=\"n\">Fridge</span></div>\n      <div class=\"slot on\"><span class=\"a\">5A</span><span class=\"n\">Water pump</span></div>\n      <div class=\"slot on\"><span class=\"a\">10A</span><span class=\"n\">Diesel heater</span></div>\n      <div class=\"slot on\"><span class=\"a\">5A</span><span class=\"n\">Roof vent</span></div>\n      <div class=\"slot spare\"><span class=\"a\">–</span><span class=\"n\">Spare</span></div>\n      <div class=\"slot spare\"><span class=\"a\">–</span><span class=\"n\">Spare</span></div>\n    </div>\n    <p class=\"body\" style=\"color:#666; font-size:22px; margin-top:-14px\" data-slot=\"noot\" data-label=\"Voetnoot\" data-max=\"70\">Example layout from our install guide. 8 of 12 slots shown, schematic.</p>\n    <div class=\"facts\">\n      <span>Blown-fuse indicator LED</span><span>Up to 30A per circuit</span><span>100A total</span><span>12–32V DC</span><span>Clear cover with labels</span><span>Fuses 5–20A included</span>\n    </div>\n  </div>\n  <div style=\"position:absolute; left:var(--pad); right:var(--pad); bottom:72px; display:flex; align-items:flex-end; justify-content:space-between\">\n    <span class=\"price\" data-slot=\"prijs\" data-label=\"Prijs\" data-max=\"10\">€33.95</span>\n    <span class=\"pill petrol\" data-slot=\"cta\" data-label=\"Knop\" data-max=\"34\">Shop · link in bio</span>\n  </div>\n</body>\n</html>\n"}